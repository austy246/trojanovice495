---
import KatastralniMapa from './KatastralniMapa.astro';
import {
	KLIC_POZEMKU,
	pozemekUDomu,
	proCast,
	type Parcela,
	vymeraKolemStaveb,
	vymeraNabidky,
	vymeraSlovy,
	vymeraStaveb,
} from '../data/parcely';
import { spolecne } from '../data/spolecne';

const cislo = new Intl.NumberFormat('cs-CZ');

/*
 * Nabídka má dvě části. U domu se neprodávají celé parcely — kolem obou staveb
 * se z luk teprve oddělí vymezený pozemek, a ten v tabulce stojí jako vlastní
 * řádek bez čísla parcely. Háječek je prostý: tři celé parcely z katastru.
 */
const uDomu = proCast('dum');
const hajecek = proCast('hajecek');

/* Stavební parcely v pořadí dům, garáž, háječek — ne podle výpisu z katastru. */
const stavby = [...uDomu, ...hajecek].filter((p) => p.stavebni);

/* Pozemek u domu je odměřený ze zákresu, součet za nabídku proto všude s „≈“. */
const vymeraText = `≈ ${vymeraSlovy(vymeraNabidky)}`;

/** „a“ místo poslední čárky: „St. 1878, St. 1879 a St. 173/4“ */
const vyjmenuj = (polozky: string[]) =>
	polozky.length < 2 ? (polozky[0] ?? '') : `${polozky.slice(0, -1).join(', ')} a ${polozky.at(-1)}`;

const detailPopis =
	`Barevně je nabídka, ${vymeraText} — vymezený pozemek u domu se stavbami ` +
	vyjmenuj(stavby.map((p) => `${p.cislo} (${p.stavba ?? 'bez stavby'})`)) +
	' a vedle něj všechny tři parcely háječku; okolí je černobílé. Jihozápadní strana ' +
	`pozemku u domu je nově vyznačená, ${pozemekUDomu.delka} m přes louku.`;

/** čím se parcela vypíše v tabulce nabídky */
const popisParcely = (p: Parcela) => p.poznamka ?? p.stavba ?? p.druh;

/*
 * Tabulka je jeden plochý seznam: nejdřív stavby u domu a pozemek kolem nich,
 * pak háječek. Mezinadpisy obou částí odpadly — výměry za obě části stojí
 * v rozpisce nad mapami a co ke které patří, říká poznámka u řádku.
 */
const casti = [uDomu, hajecek];
---

<section class="sekce" id="pozemky">
	<div class="obsah">
		<p class="nadpis-sekce">Pozemky</p>
		<h2>Pozemek u domu a háječek, {vymeraText}</h2>

		<dl class="rozpiska">
			<div><dt>Katastrální území</dt><dd>{spolecne.katastr.uzemi}</dd></div>
			<div><dt>Kód k.ú.</dt><dd>{spolecne.katastr.kod}</dd></div>
			<div>
				<dt>Stavební parcely</dt>
				<dd>{stavby.length} <span>({cislo.format(vymeraStaveb)} m²)</span></dd>
			</div>
			<div>
				<dt>Výměra v nabídce</dt>
				<dd>{vymeraText}</dd>
			</div>
		</dl>

		<div class="mapy">
			<KatastralniMapa varianta="detail" popis={detailPopis} />
		</div>

		<p class="napoveda">
			Zvětšení kolečkem myši, dvojklikem, dvěma prsty nebo tlačítky v rohu mapy; ve zvětšené mapě
			se posouvá tažením. Klepnutím na parcelu nebo na řádek tabulky se parcela zvýrazní v obou
			mapách.
		</p>

		<div class="tabulka">
			<table>
				<caption>Co je v nabídce</caption>
				<thead>
					<tr>
						<th></th>
						<th>Předmět</th>
						<th class="v">Výměra&nbsp;(m²)</th>
						<th>Poznámka</th>
						<th></th>
					</tr>
				</thead>
				{
					casti.map((cast) => (
						<tbody>
							{cast.map((p) => (
								<tr data-p={p.cislo} class={`je-nabidka${p.stavebni ? ' je-st' : ''}`} tabindex="0">
									<td class="pruh">
										<i />
									</td>
									<td class="num">{p.cislo}</td>
									<td class="v">{cislo.format(p.vymera)}</td>
									<td class="druh">{popisParcely(p)}</td>
									<td class="odkaz">
										<a href={p.kn} target="_blank" rel="noopener">
											KN&#8239;↗
										</a>
									</td>
								</tr>
							))}
							{/*
							 * Pozemek kolem staveb není parcela — teprve se z luk oddělí, proto
							 * nemá číslo ani odkaz do katastru a výměra je odměřená.
							 */}
							{cast === uDomu && (
								<tr class="je-nabidka" data-p={KLIC_POZEMKU} tabindex="0">
									<td class="pruh">
										<i />
									</td>
									<td class="num">Pozemek kolem staveb</td>
									<td class="v">≈ {cislo.format(vymeraKolemStaveb)}</td>
									<td class="druh">
										Oddělí se geometrickým plánem z {vyjmenuj([...pozemekUDomu.zParcel])}
									</td>
									<td class="odkaz" />
								</tr>
							)}
						</tbody>
					))
				}
				<tfoot>
					<tr>
						<td class="pruh"></td>
						<td>Celkem</td>
						<td class="v">≈ {cislo.format(vymeraNabidky)}</td>
						<td class="druh">
							zaokrouhleno — pozemek u domu je odměřený ze zákresu, háječek podle katastru
						</td>
						<td></td>
					</tr>
				</tfoot>
			</table>
		</div>

		<p class="zdroj">
			Geometrie parcel: RÚIAN, <a href="https://ags.cuzk.gov.cz/arcgis/rest/services/RUIAN/MapServer" target="_blank" rel="noopener">ČÚZK</a>.
			Podklad mapy: ortofoto ČÚZK v rozlišení 12,5&nbsp;cm/px a WMS Katastrální mapa,
			staženo 27.&nbsp;8.&nbsp;2026. Zobrazení je orientační a nenahrazuje
			výpis z katastru nemovitostí ani geometrický plán.
			Hranice pozemku u domu je zákres do katastrální mapy — výměra je odměřená, ne úřední,
			a oddělení parcel teprve čeká na geometrický plán.
		</p>
	</div>
</section>

<style>
	.rozpiska {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: var(--barva-pozadi-blok);
		margin: 0 0 1.5rem;
	}

	.rozpiska > div {
		padding: 0.6rem 0.9rem;
		border-right: 1px solid var(--barva-linka);
	}

	.rozpiska > div:last-child {
		border-right: none;
	}

	.rozpiska dt {
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
		margin-bottom: 0.2rem;
	}

	.rozpiska dd {
		margin: 0;
		font: 0.95rem/1.3 ui-monospace, Consolas, monospace;
		font-variant-numeric: tabular-nums;
	}

	.rozpiska dd span {
		color: var(--barva-text-tlumena);
	}

	/*
	 * Mapa je na výšku (122 × 152,5 m), takže roztažená na celou šířku obsahu
	 * by byla přes tisíc pixelů vysoká. Šířka se proto omezuje.
	 */
	.mapy {
		max-width: 36rem;
	}

	.napoveda {
		color: var(--barva-text-tlumena);
		font-size: 0.8rem;
		margin: 0.75rem 0 1.75rem;
		max-width: 52rem;
	}

	.tabulka {
		overflow-x: auto;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: var(--barva-pozadi-blok);
	}

	.tabulka table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	.tabulka caption {
		text-align: left;
		padding: 0.85rem 1rem 0;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	.tabulka th,
	.tabulka td {
		padding: 0.55rem 0.9rem;
		border-bottom: 1px solid var(--barva-linka);
		text-align: left;
	}

	.tabulka thead th {
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
		font-weight: 600;
	}

	.tabulka .v {
		text-align: right;
		font-family: ui-monospace, Consolas, monospace;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	/* Kliknout jde jen řádek s parcelou; pozemek kolem staveb v katastru není. */
	.tabulka tbody tr[data-p] {
		cursor: pointer;
	}

	/*
	 * Modrá v tabulce má tři stupně a odpovídá mapě: co je v nabídce, je lehce
	 * modré, co je pod myší o něco víc, a vybraná položka nejvíc — a mění i
	 * odstín, aby výběr nešlo splést s pouhým najetím.
	 */
	.tabulka tbody tr.je-nabidka {
		background: color-mix(in srgb, var(--barva-nabidka) 8%, transparent);
	}

	.tabulka tbody tr.je-nabidka:hover,
	.tabulka tbody tr.je-nabidka:focus-visible {
		background: color-mix(in srgb, var(--barva-nabidka) 17%, transparent);
		outline: none;
	}

	/*
	 * Musí přebít pravidlo pro najetí, které má o třídu vyšší specificitu —
	 * jinak by vybraný řádek pod myší zesvětlal zpátky na barvu najetí.
	 */
	.tabulka tbody tr.je-zvyraznena,
	.tabulka tbody tr.je-zvyraznena:hover,
	.tabulka tbody tr.je-zvyraznena:focus-visible {
		background: color-mix(in srgb, var(--barva-nabidka-vybrana) 26%, transparent);
		outline: none;
	}

	.tabulka td.pruh {
		width: 6px;
		padding: 0 0 0 6px;
	}

	.tabulka td.pruh i {
		display: block;
		width: 4px;
		height: 26px;
		border-radius: 2px;
		background: var(--barva-nabidka);
	}

	.tabulka tr.je-st td.pruh i {
		background: var(--barva-nabidka-syta);
	}

	.tabulka tr.je-zvyraznena td.pruh i {
		background: var(--barva-nabidka-vybrana);
	}

	.tabulka td.num {
		font: 600 0.9rem/1.3 ui-monospace, Consolas, monospace;
		white-space: nowrap;
	}

	.tabulka td.druh {
		color: var(--barva-text-tlumena);
	}

	.tabulka td.odkaz a {
		color: var(--barva-text-tlumena);
		text-decoration: none;
		font-size: 0.75rem;
		white-space: nowrap;
		border-bottom: 1px solid var(--barva-linka);
	}

	.tabulka td.odkaz a:hover,
	.tabulka td.odkaz a:focus-visible {
		color: var(--barva-text);
		border-color: currentColor;
	}

	.tabulka tfoot td {
		font-weight: 600;
		border-bottom: none;
	}

	.zdroj {
		color: var(--barva-text-tlumena);
		font-size: 0.75rem;
		line-height: 1.6;
		margin: 1rem 0 0;
	}

	.zdroj a {
		color: inherit;
	}
</style>

<script>
	const mapy = [...document.querySelectorAll<HTMLElement>('.mapa')];

	/* --- zvýraznění parcely v obou mapách i v tabulce --- */
	let zamcena: string | null = null;

	const oznac = (klic: string, zap: boolean) =>
		document.querySelectorAll<HTMLElement>('[data-p]').forEach((el) => {
			if (el.dataset.p === klic) el.classList.toggle('je-zvyraznena', zap);
		});

	const najeti = (klic: string, zap: boolean) => {
		if (zamcena && zamcena !== klic) return;
		oznac(klic, zap || zamcena === klic);
	};

	document.querySelectorAll<HTMLElement>('[data-p]').forEach((el) => {
		const klic = el.dataset.p;
		// je-mimo = parcela sousední nabídky, ta se zvýrazňovat nemá
		if (!klic || el.classList.contains('je-mimo')) return;

		el.addEventListener('mouseenter', () => najeti(klic, true));
		el.addEventListener('mouseleave', () => najeti(klic, false));
		el.addEventListener('focus', () => najeti(klic, true));
		el.addEventListener('blur', () => najeti(klic, false));

		const vyber = (e: Event) => {
			/*
			 * Odkaz do katastru leží uvnitř řádku, takže jeho kliknutí probublá sem.
			 * Bez téhle výjimky by ho preventDefault níž zrušil a odkaz by nefungoval.
			 */
			if ((e.target as Element | null)?.closest('a')) return;

			// tažení mapy nesmí skončit výběrem parcely
			const mapa = el.closest<HTMLElement>('.mapa');
			if (mapa && mapa.dataset.tazeno === '1') return;
			e.preventDefault();
			if (zamcena === klic) {
				zamcena = null;
				oznac(klic, false);
			} else {
				if (zamcena) oznac(zamcena, false);
				zamcena = klic;
				oznac(klic, true);
			}
		};

		el.addEventListener('click', vyber);
		el.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') vyber(e);
		});
	});

	/* --- zoom a posun --- */
	const MAX = 12;

	mapy.forEach((mapa) => {
		const scena = mapa.querySelector<HTMLElement>('.mapa__scena');
		const meritkoBox = mapa.querySelector<HTMLElement>('.mapa__meritko');
		const meritko = mapa.querySelector<HTMLElement>('.mapa__meritko span');
		const meritkoPruh = mapa.querySelector<HTMLElement>('.mapa__meritko i');
		const popisky = [...mapa.querySelectorAll<HTMLElement>('.popisek')];
		if (!scena || !meritko) return;

		const sirkaVyrezu = Number(mapa.dataset.sirka);
		const zakladniMeritko = Number(meritko.dataset.meritko);
		const tlacitko = (t: string) => mapa.querySelector<HTMLButtonElement>(`[data-z="${t}"]`);

		let k = 1;
		let x = 0;
		let y = 0;
		let tazeno = false;

		const uplatni = () => {
			const w = mapa.clientWidth;
			const h = mapa.clientHeight;
			k = Math.min(MAX, Math.max(1, k));
			x = Math.min(0, Math.max(w - w * k, x));
			y = Math.min(0, Math.max(h - h * k, y));
			scena.style.transform = `translate(${x}px, ${y}px) scale(${k})`;

			/*
			 * Délku měřítkové úsečky nejde dát procenty — .mapa__meritko je flex
			 * box široký podle obsahu, takže by se procento počítalo z něj a text
			 * by se zalomil. Počítá se proto z šířky mapy v pixelech.
			 */
			if (meritkoPruh && meritkoBox) {
				meritkoPruh.style.width = `${(Number(meritkoBox.dataset.podil) / 100) * w}px`;
			}

			const pxNaJednotku = (w / sirkaVyrezu) * k;
			mapa.style.setProperty('--u', String(pxNaJednotku));
			mapa.classList.toggle('je-zvetsena', k > 1.01);

			const dovnitr = tlacitko('in');
			const ven = tlacitko('out');
			const zpet = tlacitko('reset');
			if (dovnitr) dovnitr.disabled = k >= MAX - 0.01;
			if (ven) ven.disabled = k <= 1.01;
			if (zpet) zpet.disabled = k <= 1.01;

			/*
			 * fit je průměr největší kružnice vepsané do parcely, takže popisek
			 * zmizí přesně tehdy, když se do parcely přestane vejít. Písmo se
			 * škáluje inverzně k přiblížení, šířka textu v pixelech displeje je
			 * proto stálá a stačí ji změřit jednou.
			 */
			popisky.forEach((p) => {
				if (!p.dataset.sirkaTextu) {
					const text = p.querySelector('text:last-of-type') as SVGTextElement | null;
					const sirka = text ? text.getBBox().width * pxNaJednotku : 0;
					if (!sirka) return;
					p.dataset.sirkaTextu = String(sirka);
				}
				/*
				 * Vepsaná kružnice je střídmé měřítko: u protáhlé parcely vyjde
				 * malá, i když se do její délky popisek pohodlně vejde. Text proto
				 * smí být až dvakrát širší — na téhle hranici se popisky skrývaly
				 * i dřív, jen se tehdy délka textu nebrala v potaz.
				 */
				const misto = Number(p.dataset.fit) * pxNaJednotku;
				p.classList.toggle('je-skryty', misto < Number(p.dataset.sirkaTextu) / 2);
			});

			const m = zakladniMeritko / k;
			meritko.textContent = m >= 10 ? `${Math.round(m)} m` : `${m.toFixed(1)} m`;
		};

		const zoomNa = (cx: number, cy: number, nasobek: number) => {
			const nove = Math.min(MAX, Math.max(1, k * nasobek));
			const pomer = nove / k;
			x = cx - (cx - x) * pomer;
			y = cy - (cy - y) * pomer;
			k = nove;
			uplatni();
		};

		const vMape = (e: { clientX: number; clientY: number }): [number, number] => {
			const b = mapa.getBoundingClientRect();
			return [e.clientX - b.left, e.clientY - b.top];
		};

		mapa.addEventListener(
			'wheel',
			(e) => {
				e.preventDefault();
				const [cx, cy] = vMape(e);
				zoomNa(cx, cy, Math.exp(-e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0016)));
			},
			{ passive: false },
		);

		mapa.addEventListener('dblclick', (e) => {
			const [cx, cy] = vMape(e);
			zoomNa(cx, cy, e.shiftKey ? 0.5 : 2);
		});

		tlacitko('in')?.addEventListener('click', () => zoomNa(mapa.clientWidth / 2, mapa.clientHeight / 2, 1.8));
		tlacitko('out')?.addEventListener('click', () => zoomNa(mapa.clientWidth / 2, mapa.clientHeight / 2, 1 / 1.8));
		tlacitko('reset')?.addEventListener('click', () => {
			k = 1;
			x = 0;
			y = 0;
			uplatni();
		});

		const body = new Map<number, [number, number]>();
		let start: { px: number; py: number; x: number; y: number; k: number; dist: number; mx: number; my: number } | null =
			null;

		mapa.addEventListener('pointerdown', (e) => {
			if (e.button > 0) return;
			body.set(e.pointerId, vMape(e));
			tazeno = false;
			mapa.dataset.tazeno = '0';

			if (body.size === 1) {
				const [px, py] = body.get(e.pointerId)!;
				start = { px, py, x, y, k, dist: 0, mx: 0, my: 0 };
			} else if (body.size === 2) {
				mapa.classList.add('je-zvetsena');
				const [a, b] = [...body.values()];
				start = {
					px: 0,
					py: 0,
					x,
					y,
					k,
					dist: Math.hypot(a[0] - b[0], a[1] - b[1]),
					mx: (a[0] + b[0]) / 2,
					my: (a[1] + b[1]) / 2,
				};
			}
		});

		window.addEventListener('pointermove', (e) => {
			if (!body.has(e.pointerId) || !start) return;
			body.set(e.pointerId, vMape(e));

			if (body.size === 1 && k > 1.01) {
				const [px, py] = body.get(e.pointerId)!;
				if (Math.abs(px - start.px) + Math.abs(py - start.py) > 4) tazeno = true;
				x = start.x + (px - start.px);
				y = start.y + (py - start.py);
				mapa.classList.add('je-tazena');
				uplatni();
			} else if (body.size === 2 && start.dist) {
				const [a, b] = [...body.values()];
				const d = Math.hypot(a[0] - b[0], a[1] - b[1]);
				const nove = Math.min(MAX, Math.max(1, (start.k * d) / start.dist));
				const pomer = nove / start.k;
				x = start.mx - (start.mx - start.x) * pomer;
				y = start.my - (start.my - start.y) * pomer;
				k = nove;
				tazeno = true;
				uplatni();
			}
		});

		const konec = (e: PointerEvent) => {
			if (!body.has(e.pointerId)) return;
			body.delete(e.pointerId);
			mapa.classList.remove('je-tazena');
			start = null;
			mapa.dataset.tazeno = tazeno ? '1' : '0';
			if (tazeno) setTimeout(() => (mapa.dataset.tazeno = '0'), 0);
		};

		window.addEventListener('pointerup', konec);
		window.addEventListener('pointercancel', konec);
		window.addEventListener('resize', uplatni);

		uplatni();
	});
</script>

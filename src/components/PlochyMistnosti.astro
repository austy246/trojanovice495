---
/*
 * Rozpis ploch po místnostech. Čísla jsou opsaná z legend na stavebních
 * výkresech (A.J.A, 2004), součty se dopočítávají, aby se nemohly
 * rozejít s rozpisem ani s užitnou plochou v přehledu parametrů.
 */
import Pudorys from './Pudorys.astro';
import { nemovitost } from '../data/nemovitost';
import { podkrovi, prizemi, type PudorysSchema } from '../data/pudorys';

const { plochy } = nemovitost;

/*
 * Každé podlaží má své schéma nad svým seznamem. Podlaží bez schématu by
 * mělo seznam obyčejný — bez kurzoru, Tabu a zvýraznění, protože není
 * v čem zvýrazňovat. Popisky pod schématy říkají, co je ve výkresu
 * a co je odhad.
 */
const schemata: Record<string, PudorysSchema> = { Přízemí: prizemi, Podkroví: podkrovi };

const popisky: Record<string, string> = {
	Přízemí:
		'Schéma přízemí podle půdorysu z projektu, bez měřítka. Oblouk u dveří ukazuje, kam se ' +
		'otvírají; posuvné jsou mezi zádveřím a vstupní halou, z haly do jídelny a na obě terasy. ' +
		'Terasy v rozpisu ploch nejsou; terasa 1.15 je v projektu, postavená není.',
	Podkroví:
		'Schéma podkroví podle půdorysu z projektu, bez měřítka, ve stejném obrysu jako přízemí. ' +
		'Šrafa značí, kde podlaha není: galerie je otevřená dolů do jídelní haly u krbu a obytná hala ' +
		'má strop až do krovu.',
};

/** 7.3 → „7,30“ — desetinná čárka bez spoléhání na ICU v Node */
const cislo = (n: number) => n.toFixed(2).replace('.', ',');
const soucet = (mistnosti: { plocha: number }[]) =>
	mistnosti.reduce((s, m) => s + m.plocha, 0);

const celkem = plochy.reduce((s, p) => s + soucet(p.mistnosti), 0);
---

<section class="sekce sekce--tlumena" id="plochy">
	<div class="obsah">
		<p class="nadpis-sekce">Dispozice</p>
		<h2>Rozlohy místností</h2>
		<p class="uvod">
			Plochy podle legendy místností ve stavebních výkresech (projekt 2004). Čísla u názvů
			odpovídají popiskům v půdorysech. Terasy se do užitné plochy nepočítají — projekt
			vyčísluje jen terasu&nbsp;1.14 (10,20&nbsp;m²).
		</p>

		<p class="napoveda">
			Klepnutím na místnost ve schématu nebo v seznamu se zvýrazní v obou.
		</p>

		<div class="podlazi">
			{
				plochy.map((p) => (
					<div class="podlazi__sloupec">
						{schemata[p.podlazi] && (
							<div class="podlazi__schema">
								<Pudorys schema={schemata[p.podlazi]} podlazi={p.podlazi}>
									{popisky[p.podlazi]}
								</Pudorys>
							</div>
						)}
						<div class="podlazi__seznam">
						<h3>{p.podlazi}</h3>
						<ul class="radky mistnosti">
							{p.mistnosti.map((m) => (
								<li data-m={schemata[p.podlazi] ? m.cislo : undefined} tabindex={schemata[p.podlazi] ? 0 : undefined}>
									<span class="mistnosti__nazev">
										<span class="mistnosti__cislo">{m.cislo}</span>
										{m.nazev}
									</span>
									<strong>{cislo(m.plocha)}&nbsp;m²</strong>
								</li>
							))}
							<li class="mistnosti__soucet">
								<span class="mistnosti__nazev">Celkem</span>
								<strong>{cislo(soucet(p.mistnosti))}&nbsp;m²</strong>
							</li>
						</ul>
						</div>
					</div>
				))
			}
		</div>

		<p class="celkem">
			<span>Užitná plocha celkem</span>
			<strong>{cislo(celkem)}&nbsp;m²</strong>
		</p>
	</div>
</section>

<script>
	/*
	 * Propojení schématu se seznamem, stejně jako mapa pozemků s tabulkou:
	 * najetí nebo Tab zvýrazní místnost na obou místech, kliknutí ji zamkne,
	 * druhé kliknutí (nebo kliknutí jinam ve schématu) zámek pustí.
	 */
	const prvky = [...document.querySelectorAll<HTMLElement | SVGElement>('[data-m]')];
	let zamcena: string | null = null;

	/*
	 * Karta nad každým schématem ukazuje místnost, která je v něm právě
	 * zvýrazněná — na telefonu jsou v místnostech jen čísla. Bez zvýraznění
	 * je řádek prázdný a karta bez barvy.
	 */
	const obnovKarty = () =>
		document.querySelectorAll<HTMLElement>('.pudorys').forEach((figura) => {
			const karta = figura.querySelector<HTMLElement>('.karta');
			const cislo = figura.querySelector<HTMLElement>('.karta__cislo');
			const jmeno = figura.querySelector<HTMLElement>('.karta__jmeno');
			const plocha = figura.querySelector<HTMLElement>('.karta__plocha');
			if (!karta || !cislo || !jmeno || !plocha) return;
			const m = figura.querySelector<SVGElement>('.mistnost.je-zvyraznena');
			karta.classList.toggle('je-vybrana', !!m);
			cislo.textContent = m?.dataset.m ?? '';
			jmeno.textContent = m?.dataset.nazev ?? '';
			plocha.textContent = m?.dataset.plocha ?? '';
		});

	const oznac = (klic: string, zap: boolean) => {
		prvky.forEach((el) => {
			if (el.dataset.m === klic) el.classList.toggle('je-zvyraznena', zap);
		});
		obnovKarty();
	};

	const najeti = (klic: string, zap: boolean) => {
		if (zamcena && zamcena !== klic) return;
		oznac(klic, zap || zamcena === klic);
	};

	prvky.forEach((el) => {
		const klic = el.dataset.m;
		if (!klic) return;

		el.addEventListener('mouseenter', () => najeti(klic, true));
		el.addEventListener('mouseleave', () => najeti(klic, false));
		el.addEventListener('focus', () => najeti(klic, true));
		el.addEventListener('blur', () => najeti(klic, false));

		const vyber = (e: Event) => {
			e.preventDefault();
			if (zamcena === klic) {
				zamcena = null;
				oznac(klic, false);
			} else {
				if (zamcena) oznac(zamcena, false);
				zamcena = klic;
				oznac(klic, true);
			}
		};

		el.addEventListener('click', vyber);
		el.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') vyber(e);
		});
	});
</script>

<style>
	/*
	 * Dva sloupce, přízemí a podkroví; každé schéma stojí nad svým seznamem.
	 * Sloupec je průhledný obal (display: contents), takže schémata sedí
	 * v prvním řádku mřížky a seznamy pod nimi začínají na stejné výšce.
	 * Schémata se drží horní hrany řádku: mají stejný poměr stran a dům
	 * v nich sedí na stejném místě, takže přízemí a podkroví stojí přesně
	 * vedle sebe; delší popisek pod jedním z nich tomu nevadí.
	 * Na úzkém displeji jde všechno pod sebe: schéma, seznam, schéma, seznam.
	 */
	.podlazi {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0 clamp(2rem, 5vw, 3.5rem);
	}

	.podlazi__sloupec {
		display: contents;
	}

	.podlazi__schema {
		margin-bottom: clamp(1.5rem, 3vw, 2rem);
	}

	.podlazi__seznam {
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	@media (min-width: 46rem) {
		.podlazi {
			grid-template-columns: 1fr 1fr;
		}

		.podlazi__schema {
			grid-row: 1;
			align-self: start;
		}

		.podlazi__seznam {
			grid-row: 2;
			margin-bottom: 0;
		}
	}

	.podlazi h3 {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-family: var(--pismo-ui);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	/*
	 * Položka s místností ve schématu se chová jako řádek tabulky pozemků:
	 * stejná modrá, stejné tři stupně. Podklad zvýraznění přesahuje o kus
	 * do stran, aby text neseděl na jeho hraně — kreslí ho pseudoprvek,
	 * takže linka pod položkou zůstává tam, kde ji mají ostatní.
	 */
	.mistnosti li[data-m] {
		position: relative;
		/* vlastní stacking context, jinak by podklad se z-index -1 zapadl za pozadí sekce */
		isolation: isolate;
		cursor: pointer;
		outline: none;
	}

	.mistnosti li[data-m]::before {
		content: '';
		position: absolute;
		inset: 1px -0.5rem;
		border-radius: 2px;
		background: transparent;
		z-index: -1;
		transition: background 0.12s;
	}

	.mistnosti li[data-m]:hover::before,
	.mistnosti li[data-m]:focus-visible::before {
		background: color-mix(in srgb, var(--barva-nabidka) 17%, transparent);
	}

	.mistnosti li.je-zvyraznena::before,
	.mistnosti li.je-zvyraznena:hover::before,
	.mistnosti li.je-zvyraznena:focus-visible::before {
		background: color-mix(in srgb, var(--barva-nabidka-vybrana) 26%, transparent);
	}

	/* číslo místnosti drží svůj sloupec, aby názvy začínaly pod sebou */
	.mistnosti__cislo {
		display: inline-block;
		width: 2.75rem;
		font-size: 0.8125rem;
		color: var(--barva-text-tlumena);
		font-variant-numeric: tabular-nums;
	}

	.mistnosti__soucet {
		border-bottom: 0;
		padding-top: 0.75rem;
	}

	.mistnosti__soucet .mistnosti__nazev {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	.celkem {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: clamp(2rem, 5vw, 3rem) 0 0;
		padding-top: 1rem;
		border-top: 2px solid var(--barva-akcent);
	}

	.celkem span {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	.celkem strong {
		font-weight: 500;
		font-size: clamp(1.5rem, 4vw, 2rem);
		white-space: nowrap;
	}
</style>

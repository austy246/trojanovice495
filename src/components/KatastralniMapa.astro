---
import { parcely, pozemekUDomu, VYREZY, type Nabidka } from '../data/parcely';

interface Props {
	/** který výřez se vykresluje */
	varianta: 'prehled' | 'detail';
	/** popisek pod mapou, slouží zároveň jako přístupový název */
	popis: string;
	/** parcely mimo tuto nabídku se kreslí ztlumeně a nejsou interaktivní */
	nabidka: Nabidka;
}

const { varianta, popis, nabidka } = Astro.props;

const jeNase = (p: (typeof parcely)[number]) => p.nabidka === nabidka;

/*
 * Nabídka ① má dvě úrovně: modrý je jen vymezený pozemek u domu, okolní louky
 * jsou bílé. Nabídka ② žádné dělení nemá, modré je v ní všechno.
 */
const dvouurovnova = nabidka === 'dum';

/*
 * Kreslí se vždy všechny parcely — soused je užitečný kontext. Ty mimo
 * nabídku ale dostanou třídu je-mimo: ztlumené, bez kliknutí i bez Tabu.
 * Louky navíc mají je-doplnek: bílé jako sousedi, ale klikací.
 */
const trida = (p: (typeof parcely)[number]) => {
	const zaklad = p.stavebni ? 'je-st' : 'je-poz';
	if (!jeNase(p)) return `${zaklad} je-mimo`;
	return dvouurovnova && !p.stavebni ? `${zaklad} je-doplnek` : zaklad;
};
const vyrez = VYREZY[varianta];
const viewBox = `0 0 ${vyrez.sirka} ${vyrez.vyska}`;
const pomer = ((vyrez.vyska / vyrez.sirka) * 100).toFixed(3);

/*
 * Obě mapy se skládají stejně: ortofoto ČÚZK a nad ním katastrální kresba jako
 * samostatná průhledná vrstva. Oboje generuje scripts/podklady.mjs.
 */
const jeDetail = varianta === 'detail';

/*
 * Rozteč šrafů se odvozuje od šířky výřezu, aby byly v obou mapách stejně
 * husté na obrazovce, ne v jednotkách viewBoxu.
 */
const krok = Math.round(vyrez.sirka / 55);
const idSraf = `srafy-${varianta}`;

const pozemek = dvouurovnova ? pozemekUDomu[varianta] : null;
---

<figure class="mapa-fig">
	<div class="mapa" data-mapa={varianta} data-sirka={vyrez.sirka}>
		<div class="mapa__pomer" style={`padding-top:${pomer}%`}></div>

		<div class="mapa__scena">
			<picture>
				<source srcset={`/katastr/${varianta}-orto.avif`} type="image/avif" />
				<img
					class="mapa__vrstva mapa__orto"
					src={`/katastr/${varianta}-orto.webp`}
					alt="Ortofoto ČÚZK"
					draggable="false"
					loading="lazy"
				/>
			</picture>

			<svg class="mapa__vrstva mapa__vyplne" viewBox={viewBox} preserveAspectRatio="none" aria-hidden="true">
				<defs>
					<pattern id={idSraf} width={krok} height={krok} patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
						<line x1="0" y1="0" x2="0" y2={krok} stroke="#8ecbff" stroke-width={krok / 5} />
					</pattern>
				</defs>

				{
					parcely.map((p) => (
						<path class={`vyplen ${trida(p)}`} data-p={p.cislo} d={p[varianta].d} />
					))
				}

				{/*
				 * Šrafy nesou modrou plochu nabídky. U domu je to jen vymezený
				 * pozemek, u háječku všechny jeho parcely.
				 */}
				{
					!dvouurovnova &&
						parcely
							.filter(jeNase)
							.map((p) => <path class="srafy" d={p[varianta].d} fill={`url(#${idSraf})`} />)
				}

				{
					pozemek && (
						<>
							<path class="vyplen je-pozemek" d={pozemek.d} />
							<path class="srafy" d={pozemek.d} fill={`url(#${idSraf})`} />
						</>
					)
				}
			</svg>

			<img
				class="mapa__vrstva mapa__km"
				src={`/katastr/${varianta}-kresba.webp`}
				alt="Katastrální mapa ČÚZK"
				draggable="false"
				loading="lazy"
			/>

			<svg class="mapa__vrstva" viewBox={viewBox} preserveAspectRatio="none" role="img" aria-label={popis}>
				{
					parcely.map((p) => (
						<path
							class={`obrys ${trida(p)}`}
							data-p={p.cislo}
							d={p[varianta].d}
							tabindex={jeNase(p) ? '0' : undefined}
							role={jeNase(p) ? 'button' : undefined}
							aria-hidden={jeNase(p) ? undefined : 'true'}
							aria-label={jeNase(p) ? `${p.cislo}, ${p.vymera} m², ${p.druh}` : undefined}
						>
							{jeNase(p) && <title>{`${p.cislo} · ${p.vymera} m² · ${p.druh}`}</title>}
						</path>
					))
				}
				{pozemek && <path class="pozemek" d={pozemek.d} />}

				{/*
				 * V detailu má podklad čísla parcel vypálená v obrázku, takže se
				 * kreslí jen stavební parcely nabídky — v podkladu jsou bez předpony
				 * „St.“ a jsou to ty, na kterých v této mapě záleží. V přehledu
				 * podklad popisky nemá, tam se kreslí všechny.
				 */}
				<g class="mapa__popisky">
					{
						parcely
							.filter((p) => (jeDetail ? jeNase(p) && p.stavebni : true))
							.map((p) => (
								<g class={`popisek ${jeNase(p) ? '' : 'je-mimo'}`} data-p={p.cislo} data-fit={p[varianta].fit}>
									<text x={p[varianta].x} y={p[varianta].y} class="halo">
										{p.cislo}
									</text>
									<text x={p[varianta].x} y={p[varianta].y}>
										{p.cislo}
									</text>
								</g>
							))
					}
				</g>
			</svg>
		</div>

		<div class="mapa__sever" aria-hidden="true">S</div>
		<div class="mapa__meritko" data-podil={vyrez.meritkoPodil}>
			<i></i>
			<span data-meritko={vyrez.meritko}>{vyrez.meritko} m</span>
		</div>
		<div class="mapa__zoom">
			<button type="button" data-z="in" aria-label="Přiblížit">+</button>
			<button type="button" data-z="out" aria-label="Oddálit">−</button>
			<button type="button" data-z="reset" aria-label="Zpět na celý výřez">⟲</button>
		</div>
	</div>
	<figcaption>{popis}</figcaption>
</figure>

<style>
	.mapa-fig {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.mapa-fig figcaption {
		color: var(--barva-text-tlumena);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	/*
	 * --u = kolik pixelů displeje připadá na jednotku viewBoxu. Obrysy i popisky
	 * se jím dělí, takže při zvětšení drží stálou tloušťku a velikost.
	 */
	.mapa {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: #0c0e0c;
		line-height: 0;
		touch-action: pan-y;
		cursor: grab;
		--u: 0.25;
	}

	.mapa.je-zvetsena {
		touch-action: none;
	}

	.mapa.je-tazena {
		cursor: grabbing;
	}

	.mapa__pomer {
		width: 100%;
	}

	.mapa__scena {
		position: absolute;
		inset: 0;
		transform-origin: 0 0;
		will-change: transform;
	}

	.mapa__vrstva {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		user-select: none;
	}

	/*
	 * Barvu výplně a barvu obrysu drž v oddělených pravidlech. Sloučené
	 * `.vyplen.je-st, .obrys.je-st { fill: … }` má vyšší specificitu než
	 * `.obrys { fill: none }` a obarvilo by i obrysovou vrstvu, která žádnou
	 * průhlednost nemá — parcely by přes ortofoto vyšly jako plné plochy.
	 */
	/*
	 * Nabízené pozemky jsou modré v obou nabídkách; stavební parcely jen sytěji,
	 * protože jsou drobné a proti ortofotu by se ztratily.
	 */
	.vyplen {
		stroke: none;
		fill: #2e9bff;
		fill-opacity: 0.14;
	}

	.vyplen.je-st {
		fill: #0f7ae5;
		fill-opacity: 0.42;
	}

	/* Šrafy leží nad výplní a nesmí brát kliknutí obrysové vrstvě pod sebou. */
	.srafy {
		pointer-events: none;
		opacity: 0.32;
	}

	.obrys {
		fill: none;
		stroke-width: calc(2.6px / var(--u));
		stroke-linejoin: round;
		cursor: pointer;
		outline: none;
	}

	.obrys.je-st {
		stroke: #c7e9ff;
	}

	.obrys.je-poz {
		stroke: #35a4ff;
	}

	/*
	 * Vymezený pozemek u domu nese modrou plochu nabídky ①, proto vypadá jako
	 * nabízená parcela — včetně obvodu. Že jedna jeho strana nemá oporu
	 * v katastru, říká text pod mapou, ne odlišná čára.
	 */
	.vyplen.je-pozemek {
		fill: #2e9bff;
		fill-opacity: 0.2;
	}

	.pozemek {
		fill: none;
		pointer-events: none;
		stroke: #35a4ff;
		stroke-width: calc(2.6px / var(--u));
		stroke-linejoin: round;
	}

	.obrys:hover,
	.obrys.je-zvyraznena,
	.obrys:focus-visible {
		stroke-width: calc(5px / var(--u));
	}

	.vyplen.je-zvyraznena {
		fill-opacity: 0.6;
	}

	/*
	 * Parcely mimo nabídku. Zůstávají vidět jako kontext, ale nejsou barevné,
	 * nedají se kliknout ani chytit Tabem a nereagují na zvýraznění.
	 */
	.vyplen.je-mimo {
		fill: #fff;
		fill-opacity: 0.06;
	}

	.obrys.je-mimo {
		stroke: rgba(255, 255, 255, 0.45);
		stroke-width: calc(1.4px / var(--u));
		stroke-dasharray: calc(6px / var(--u)) calc(4px / var(--u));
		pointer-events: none;
		cursor: default;
	}

	/*
	 * Louky navíc u nabídky ①. Bílé jako sousední parcely, aby modrá zůstala
	 * jen pozemku u domu, ale plnou čarou a klikací — do nabídky patří.
	 * Musí přebít .je-poz, proto stojí až za ním.
	 */
	.vyplen.je-doplnek {
		fill: #fff;
		fill-opacity: 0.06;
	}

	.obrys.je-doplnek {
		stroke: rgba(255, 255, 255, 0.7);
		stroke-width: calc(1.8px / var(--u));
	}

	/* bílá plocha při zvýraznění oslňuje, stačí jí menší krytí než modré */
	.vyplen.je-doplnek.je-zvyraznena {
		fill-opacity: 0.26;
	}

	.popisek.je-mimo text {
		fill: rgba(255, 255, 255, 0.5);
	}

	.mapa__popisky text {
		font: 600 calc(13.5px / var(--u)) ui-monospace, Consolas, monospace;
		fill: #fff;
		text-anchor: middle;
		dominant-baseline: middle;
		paint-order: stroke;
		pointer-events: none;
	}

	.mapa__popisky .halo {
		stroke: #0b0d0b;
		stroke-width: calc(3.4px / var(--u));
		opacity: 0.92;
	}

	.popisek.je-skryty {
		display: none;
	}

	.mapa__sever {
		position: absolute;
		top: 10px;
		right: 12px;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: rgba(10, 12, 10, 0.62);
		color: #fff;
		font: 600 11px/26px var(--pismo-ui);
		text-align: center;
	}

	.mapa__sever::before {
		content: '▲';
		position: absolute;
		top: -9px;
		left: 50%;
		transform: translateX(-50%);
		font-size: 9px;
	}

	.mapa__meritko {
		position: absolute;
		left: 12px;
		bottom: 11px;
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: 0.4rem;
		max-width: calc(100% - 24px);
		background: rgba(10, 12, 10, 0.62);
		padding: 5px 8px;
		border-radius: 2px;
	}

	.mapa__meritko i {
		display: block;
		flex: none;
		height: 5px;
		border: 1.5px solid #fff;
		border-top: none;
	}

	.mapa__meritko span {
		color: #fff;
		white-space: nowrap;
		font: 600 11px/1 ui-monospace, Consolas, monospace;
	}

	.mapa__zoom {
		position: absolute;
		right: 10px;
		bottom: 10px;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.mapa__zoom button {
		width: 34px;
		height: 34px;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 3px;
		background: rgba(10, 12, 10, 0.66);
		color: #fff;
		font: 500 17px/1 var(--pismo-ui);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.mapa__zoom button:hover {
		background: rgba(10, 12, 10, 0.85);
	}

	.mapa__zoom button:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 1px;
	}

	.mapa__zoom button[disabled] {
		opacity: 0.4;
		cursor: default;
	}
</style>

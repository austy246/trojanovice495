---
import '../styles/global.css';
import { nemovitost } from '../data/nemovitost';

interface Props {
	titulek: string;
	popis: string;
}

const { titulek, popis } = Astro.props;
const kanonicka = new URL(Astro.url.pathname, Astro.site);

const { sirka, delka } = nemovitost.souradnice;
const mapa = `https://mapy.cz/zakladni?x=${delka}&y=${sirka}&z=17&source=coor&id=${delka}%2C${sirka}`;
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={kanonicka} />

		<title>{titulek}</title>
		<meta name="description" content={popis} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="cs_CZ" />
		<meta property="og:title" content={titulek} />
		<meta property="og:description" content={popis} />
		<meta property="og:url" content={kanonicka} />
	</head>
	<body>
		<slot />

		<footer class="paticka">
			<div class="obsah">
				<p>
					Trojanovice 495, 744 01 Trojanovice —
					<a href={mapa} target="_blank" rel="noopener">ukázat na mapy.cz</a>
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.paticka {
		border-top: 1px solid var(--barva-linka);
		padding-block: 2rem;
		font-size: 0.875rem;
		color: var(--barva-text-tlumena);
	}

	.paticka p {
		margin: 0;
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Pozemky from '../components/Pozemky.astro';
import Cena from '../components/Cena.astro';
import { hajecek } from '../data/hajecek';
import { spolecne, telefonHref } from '../data/spolecne';

const { nazev, podtitul, perex, cena, cenaPoznamka, parametry } = hajecek;
const { lokalita, kontakt } = spolecne;
---

<Layout titulek={`${nazev} — Trojanovice`} popis={perex}>
	{/* Na háječek zatím nejsou fotky, úvod proto stojí jen na textu. */}
	<header class="hero">
		<div class="obsah">
			<p class="nadpis-sekce">{podtitul}</p>
			<h1>{nazev}</h1>
			<p class="hero__perex">{perex}</p>
			<Cena cena={cena} poznamka={cenaPoznamka} />
		</div>
	</header>

	<section class="sekce sekce--tlumena" id="parametry">
		<div class="obsah">
			<p class="nadpis-sekce">Přehled</p>
			<h2>Základní parametry</h2>
			<dl class="parametry">
				{
					parametry.map((polozka) => (
						<div class="parametry__polozka">
							<dt>{polozka.nazev}</dt>
							<dd>{polozka.hodnota}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<Pozemky nabidka="hajecek" />

	<section class="sekce sekce--tlumena" id="lokalita">
		<div class="obsah">
			<p class="nadpis-sekce">Okolí</p>
			<h2>Lokalita</h2>
			<p class="lokalita__popis">{lokalita.popis}</p>
			<ul class="vzdalenosti">
				{
					lokalita.vzdalenosti.map((polozka) => (
						<li>
							<span>{polozka.misto}</span>
							<strong>{polozka.hodnota}</strong>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="sekce" id="kontakt">
		<div class="obsah">
			<p class="nadpis-sekce">Máte zájem?</p>
			<h2>Kontakt přímo na majitele</h2>
			<p class="kontakt">
				{kontakt.jmeno}<br />
				<a href={telefonHref}>{kontakt.telefon}</a><br />
				<a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
			</p>
			<p class="kontakt__poznamka">
				Prodávám sám, bez realitní kanceláře — ozvěte se mi přímo.
				Vedle háječku nabízím samostatně i <a href="/dum">dům se zahradou a loukami</a>.
			</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-block: clamp(2.5rem, 7vw, 4.5rem);
		border-bottom: 1px solid var(--barva-linka);
	}

	.hero__perex {
		max-width: 42rem;
		margin-top: clamp(1.5rem, 4vw, 2.25rem);
		font-size: 1.125rem;
		color: var(--barva-text-tlumena);
	}

	.parametry {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1.5rem 2rem;
		margin: 0;
	}

	.parametry__polozka {
		border-top: 1px solid var(--barva-linka);
		padding-top: 0.75rem;
	}

	.parametry dt {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	.parametry dd {
		margin: 0.25rem 0 0;
		font-family: var(--pismo);
		font-size: 1.375rem;
	}

	.lokalita__popis {
		max-width: 42rem;
		margin-top: 0;
	}

	.vzdalenosti {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		max-width: 32rem;
	}

	.vzdalenosti li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--barva-linka);
	}

	.kontakt {
		font-size: 1.125rem;
	}

	.kontakt__poznamka {
		color: var(--barva-text-tlumena);
		max-width: 34rem;
	}
</style>

---
import '../styles/global.css';

interface Props {
	titulek: string;
	popis: string;
}

const { titulek, popis } = Astro.props;
const kanonicka = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={kanonicka} />

		<title>{titulek}</title>
		<meta name="description" content={popis} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="cs_CZ" />
		<meta property="og:title" content={titulek} />
		<meta property="og:description" content={popis} />
		<meta property="og:url" content={kanonicka} />
	</head>
	<body>
		<slot />

		<footer class="paticka">
			<div class="obsah">
				<p>Trojanovice 495, 744 01 Trojanovice</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.paticka {
		border-top: 1px solid var(--barva-linka);
		padding-block: 2rem;
		font-size: 0.875rem;
		color: var(--barva-text-tlumena);
	}

	.paticka p {
		margin: 0;
	}
</style>

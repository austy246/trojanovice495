---
import Layout from '../layouts/Layout.astro';
import { nemovitost } from '../data/nemovitost';
import { hajecek } from '../data/hajecek';
import { spolecne, telefonHref } from '../data/spolecne';
import { vymeraNabidky, vymeraSlovy } from '../data/parcely';

const { uvodniFoto } = nemovitost;
const { kontakt } = spolecne;

const cislo = new Intl.NumberFormat('cs-CZ');

// Pořadí i názvy odpovídají tištěnému banneru.
const nabidky = [
	{
		odkaz: '/dum',
		nazev: 'Dům, garáž, zahrada',
		vymera: `${cislo.format(vymeraNabidky('dum'))} m² · ${vymeraSlovy(vymeraNabidky('dum'))}`,
		popis:
			'Rodinný dům z roku 2006 se sedmi pokoji, garáží pro dva vozy, vzrostlou zahradou ' +
			'a loukami až k lesu.',
	},
	{
		odkaz: '/hajecek',
		nazev: hajecek.nazev,
		vymera: `${cislo.format(vymeraNabidky('hajecek'))} m²`,
		popis: 'Volná stavební parcela se vzrostlou zelení kolem, na stejném svahu nad obcí.',
	},
];

const titulek = 'Trojanovice 495 — dvě nabídky pod Radhoštěm';
const popis =
	'Na horním konci Trojanovic prodávám přímo bez realitní kanceláře dvě samostatné ' +
	'nabídky: rodinný dům se zahradou a loukami, a stavební parcelu s háječkem.';
---

<Layout titulek={titulek} popis={popis}>
	<header class="hero">
		<picture>
			<source media="(max-width: 60rem)" srcset={`/fotky/${uvodniFoto.souborNaVysku}`} />
			<img class="hero__foto" src={`/fotky/${uvodniFoto.soubor}`} alt={uvodniFoto.popis} fetchpriority="high" />
		</picture>
		<div class="hero__titulek">
			<div class="obsah">
				<p class="nadpis-sekce">Trojanovice pod Radhoštěm</p>
				<h1>Trojanovice 495</h1>
			</div>
		</div>
	</header>

	<section class="sekce">
		<div class="obsah">
			<p class="uvod">{popis}</p>

			<ul class="nabidky">
				{
					nabidky.map((n, i) => (
						<li class="nabidka">
							<a href={n.odkaz}>
								<span class="nabidka__cislo" aria-hidden="true">
									{i + 1}
								</span>
								<h2>{n.nazev}</h2>
								<p class="nabidka__vymera">{n.vymera}</p>
								<p class="nabidka__popis">{n.popis}</p>
								<span class="nabidka__vice">Podrobnosti →</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="sekce sekce--tlumena">
		<div class="obsah">
			<p class="nadpis-sekce">Máte zájem?</p>
			<h2>Kontakt přímo na majitele</h2>
			<p class="kontakt">
				{kontakt.jmeno}<br />
				<a href={telefonHref}>{kontakt.telefon}</a><br />
				<a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
			</p>
			<p class="kontakt__poznamka">
				Prodávám sám, bez realitní kanceláře — ozvěte se mi přímo.
			</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		position: relative;
	}

	.hero picture {
		display: block;
	}

	.hero__foto {
		display: block;
		width: 100%;
		height: clamp(18rem, 52vh, 30rem);
		object-fit: cover;
		object-position: 50% 45%;
	}

	@media (max-width: 60rem) {
		.hero__foto {
			object-position: 50% 50%;
		}
	}

	.hero__titulek {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding-block: clamp(4rem, 12vh, 7rem) clamp(1.5rem, 4vh, 2.5rem);
		background: linear-gradient(to top, rgba(16, 14, 11, 0.74), rgba(16, 14, 11, 0.4) 45%, transparent);
	}

	.hero__titulek h1 {
		color: #fff;
	}

	.hero__titulek .nadpis-sekce {
		color: rgba(255, 255, 255, 0.85);
		margin-bottom: 0.5rem;
	}

	.uvod {
		max-width: 42rem;
		margin: 0 0 clamp(2rem, 5vw, 3rem);
		font-size: 1.125rem;
		color: var(--barva-text-tlumena);
	}

	.nabidky {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: 1fr;
	}

	@media (min-width: 48rem) {
		.nabidky {
			grid-template-columns: 1fr 1fr;
		}
	}

	.nabidka a {
		display: block;
		height: 100%;
		padding: 1.75rem;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: var(--barva-pozadi-blok);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s, transform 0.15s;
	}

	.nabidka a:hover,
	.nabidka a:focus-visible {
		border-color: var(--barva-akcent);
		transform: translateY(-2px);
	}

	.nabidka__cislo {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--barva-akcent);
		color: var(--barva-pozadi);
		font: 600 0.9rem/1 var(--pismo-ui);
		margin-bottom: 1rem;
	}

	.nabidka h2 {
		margin: 0 0 0.35rem;
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
	}

	.nabidka__vymera {
		margin: 0 0 0.9rem;
		font: 0.9rem/1.3 ui-monospace, Consolas, monospace;
		font-variant-numeric: tabular-nums;
		color: var(--barva-text-tlumena);
	}

	.nabidka__popis {
		margin: 0 0 1.25rem;
	}

	.nabidka__vice {
		color: var(--barva-akcent);
		font-size: 0.9rem;
	}

	.kontakt {
		font-size: 1.125rem;
	}

	.kontakt__poznamka {
		color: var(--barva-text-tlumena);
		max-width: 34rem;
	}
</style>

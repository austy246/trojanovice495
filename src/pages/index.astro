---
import Layout from '../layouts/Layout.astro';
import Pozemky from '../components/Pozemky.astro';
import PlochyMistnosti from '../components/PlochyMistnosti.astro';
import Cena from '../components/Cena.astro';
import { existsSync, statSync } from 'node:fs';
import { resolve } from 'node:path';
import { energie, nemovitost } from '../data/nemovitost';
import { spolecne, telefonHref } from '../data/spolecne';

const { nazev, podtitul, perex, cena, cenaPoznamka, uvodniFoto, parametry, galerie } = nemovitost;
const { lokalita, kontakt } = spolecne;

const cisloCZ = new Intl.NumberFormat('cs-CZ');

/*
 * Odkaz na průkaz se ukáže, jen když soubor v public/ opravdu leží. Mrtvý
 * odkaz ke stažení je horší než žádný, a tohle se pozná při buildu.
 */
const cestaPrukazu = resolve(process.cwd(), `public${energie.prukaz.soubor}`);
const maPrukaz = existsSync(cestaPrukazu);

/** U odkazu ke stažení patří velikost — ať člověk ví, do čeho jde, než klikne. */
const velikostPrukazu = maPrukaz
	? `${(statSync(cestaPrukazu).size / 1024 / 1024).toFixed(1).replace('.', ',')} MB`
	: '';
---

<Layout titulek={`${nazev} — ${podtitul}`} popis={perex}>
	<header class="hero">
		<div class="obsah hero__titulek">
			<p class="nadpis-sekce">{podtitul}</p>
			<h1>{nazev}</h1>
		</div>

		<div class="hero__media">
			<picture>
				<source media="(max-width: 60rem)" srcset={`/fotky/${uvodniFoto.souborNaVysku}`} />
				<img class="hero__foto" src={`/fotky/${uvodniFoto.soubor}`} alt={uvodniFoto.popis} fetchpriority="high" />
			</picture>
		</div>

		<div class="obsah">
			<p class="uvod hero__perex">{perex}</p>
		</div>
	</header>

	<section class="sekce sekce--tlumena" id="parametry">
		<div class="obsah">
			<p class="nadpis-sekce">Přehled</p>
			<h2>Základní parametry</h2>
			<dl class="rozpiska">
				{
					parametry.map((polozka) => (
						<div>
							<dt>{polozka.nazev}</dt>
							<dd>{polozka.hodnota}</dd>
						</div>
					))
				}
			</dl>

			<div class="provoz">
				<p class="stitek">
					<span class="stitek__trida">{energie.trida}</span>
					Energetická třída {energie.trida} — {energie.tridaSlovy}
				</p>
				<p class="provoz__text">
					Dům má velmi úsporný a jednoduchý provoz. Vytápění i ohřev vody zajišťuje
					tepelné čerpadlo země–voda a veškeré ostatní technologie včetně vaření jsou
					rovněž na elektřinu. Plyn není do domu zaveden a voda je čerpána z vlastní
					studny. Pravidelné měsíční náklady na energie tak představují pouze
					elektřinu, aktuálně přibližně <strong>{cisloCZ.format(energie.mesicne)} Kč měsíčně</strong>.
				</p>
				<p class="provoz__prukaz">
					Průkaz energetické náročnosti ev.&nbsp;č. {energie.prukaz.evidencni}, vyhotovil
					{' '}{energie.prukaz.specialista} {energie.prukaz.vyhotoven}, platný do {energie.prukaz.platnyDo}.
					{
						maPrukaz && (
							<>
								{' '}
								<a href={energie.prukaz.soubor} download>Stáhnout průkaz (PDF, {velikostPrukazu})&nbsp;↓</a>
							</>
						)
					}
				</p>
			</div>
		</div>
	</section>

	{
		galerie.length > 0 && (
			<section class="sekce" id="galerie">
				<div class="obsah">
					<p class="nadpis-sekce">Fotografie</p>
					<h2>Prohlídka</h2>
					<div class="galerie">
						{galerie.map((fotka, index) => (
							<figure class="galerie__polozka">
								{/* poměr stran drží CSS, fotky jsou na výšku i na šířku */}
								<img
									src={`/fotky/${fotka.soubor}`}
									alt={fotka.popis}
									loading={index === 0 ? 'eager' : 'lazy'}
								/>
								<figcaption>{fotka.popis}</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="sekce" id="video">
		<div class="obsah">
			<p class="nadpis-sekce">Video</p>
			<h2>Video prohlídka</h2>
			<video
				class="video-prohlidka"
				controls
				playsinline
				preload="none"
				poster="/video/poster.jpg"
				width="1920"
				height="1080"
			>
				<source src="/video/prohlidka-mobile.mp4" media="(max-width: 40rem)" type="video/mp4" />
				<source src="/video/prohlidka.mp4" type="video/mp4" />
				Váš prohlížeč přehrávání videa nepodporuje. Video si můžete
				<a href="/video/prohlidka.mp4">stáhnout přímo</a>.
			</video>
		</div>
	</section>

	<PlochyMistnosti />

	<Pozemky />

	<section class="sekce" id="cena">
		<div class="obsah">
			<p class="nadpis-sekce">Nabídka</p>
			<h2>Cena</h2>
			<Cena cena={cena} poznamka={cenaPoznamka} />
		</div>
	</section>

	<section class="sekce sekce--tlumena" id="lokalita">
		<div class="obsah">
			<p class="nadpis-sekce">Okolí</p>
			<h2>Lokalita</h2>
			<p class="uvod">{lokalita.popis}</p>
			<ul class="radky vzdalenosti">
				{
					lokalita.vzdalenosti.map((polozka) => (
						<li>
							<span>{polozka.misto}</span>
							<strong>{polozka.hodnota}</strong>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="sekce" id="kontakt">
		<div class="obsah">
			<p class="nadpis-sekce">Máte zájem?</p>
			<h2>Kontakt přímo na majitele</h2>
			<p class="kontakt">
				{kontakt.jmeno}<br />
				<a href={telefonHref}>{kontakt.telefon}</a><br />
				<a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
			</p>
			<p class="uvod">
				Prodávám sám, bez realitní kanceláře — ozvěte se mi přímo. Dům i háječek se
				prodávají dohromady, jako jeden celek. Projektovou dokumentaci domu (půdorysy
				a řezy z roku 2004) pošlu na vyžádání.
			</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
		border-bottom: 1px solid var(--barva-linka);
	}

	.hero__media picture {
		display: block;
	}

	.hero__foto {
		display: block;
		width: 100%;
		height: clamp(21rem, 66vh, 38rem);
		object-fit: cover;
		/* Nižší hodnota ukazuje horní část fotky, vyšší ji posune dolů a přidá víc trávy pod domem. */
		object-position: 50% 62%;
	}

	/* varianta na výšku je oříznutá už v souboru, stačí ji držet u středu */
	@media (max-width: 60rem) {
		.hero__foto {
			object-position: 50% 50%;
		}
	}

	.hero__titulek {
		padding-block: clamp(2rem, 6vw, 3.5rem) clamp(1.5rem, 4vw, 2rem);
	}

	.hero__titulek .nadpis-sekce {
		margin-bottom: 0.5rem;
	}

	/* úvod hera je větší než úvody sekcí a má odstup od fotky */
	.hero__perex {
		margin: clamp(2rem, 5vw, 3rem) 0 1.125rem;
		font-size: 1.125rem;
	}

	/*
	 * Provozní náklady. Nedělá se z nich vlastní ostrůvek s rámečkem a jiným
	 * pozadím — v sekci už je rozpiska a druhá krabice by působila jako cizí
	 * prvek. Drží se proto stejné vodorovné linky jako položky přehledu nad ní.
	 */
	.provoz {
		margin: 2.5rem 0 0;
		max-width: 42rem;
		border-top: 1px solid var(--barva-linka);
		padding-top: 1.25rem;
	}

	/*
	 * Štítek energetické třídy. Písmeno je jediné, co jde porovnat napříč
	 * inzeráty, tak ať je vidět — zelená je ale ztlumená do teplé palety webu,
	 * aby vedle krémového podkladu nekřičela.
	 */
	.stitek {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 0.9rem;
		padding: 0.3rem 0.8rem 0.3rem 0.35rem;
		border: 1px solid var(--barva-linka);
		border-radius: 999px;
		background: var(--barva-pozadi);
		font-family: var(--pismo-ui);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		color: var(--barva-text-tlumena);
	}

	.stitek__trida {
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 999px;
		background: #3f7d54;
		color: #fff;
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0;
	}

	.provoz__text {
		margin: 0;
		max-width: 42rem;
		line-height: 1.7;
	}

	.provoz__prukaz {
		margin: 0.7rem 0 0;
		max-width: 42rem;
		color: var(--barva-text-tlumena);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	/*
	 * Mřížka fotek: na šířce obsahu tři sloupce, na tabletu dva, na telefonu
	 * jeden. Poměr stran drží CSS, fotky jsou na výšku i na šířku.
	 */
	.galerie {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: 1.5rem;
	}

	.galerie__polozka {
		margin: 0;
	}

	.galerie__polozka img {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		background: var(--barva-pozadi-blok);
		border-radius: 2px;
	}

	.video-prohlidka {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		background: #000;
		border-radius: 2px;
	}

	.galerie figcaption {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		color: var(--barva-text-tlumena);
	}

	.vzdalenosti {
		max-width: 42rem;
	}

	.kontakt {
		font-size: 1.125rem;
	}
</style>

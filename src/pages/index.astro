---
import Layout from '../layouts/Layout.astro';
import Pozemky from '../components/Pozemky.astro';
import { nemovitost } from '../data/nemovitost';

const { nazev, podtitul, perex, uvodniFoto, parametry, rozlozeni, galerie, lokalita, kontakt } = nemovitost;
const telefonHref = 'tel:' + kontakt.telefon.replace(/\s/g, '');
---

<Layout titulek={`${nazev} — ${podtitul}`} popis={perex}>
	<header class="hero">
		<div class="hero__media">
			<img class="hero__foto" src={`/fotky/${uvodniFoto.soubor}`} alt={uvodniFoto.popis} fetchpriority="high" />
			<div class="hero__titulek">
				<div class="obsah">
					<p class="nadpis-sekce">{podtitul}</p>
					<h1>{nazev}</h1>
				</div>
			</div>
		</div>

		<div class="obsah">
			<p class="hero__perex">{perex}</p>
		</div>
	</header>

	<section class="sekce sekce--tlumena" id="parametry">
		<div class="obsah">
			<p class="nadpis-sekce">Přehled</p>
			<h2>Základní parametry</h2>
			<dl class="parametry">
				{
					parametry.map((polozka) => (
						<div class="parametry__polozka">
							<dt>{polozka.nazev}</dt>
							<dd>{polozka.hodnota}</dd>
						</div>
					))
				}
			</dl>

			<ul class="rozlozeni">
				{
					rozlozeni.map((podlazi) => (
						<li>
							<span>{podlazi.podlazi}</span>
							<strong>{podlazi.mistnosti}</strong>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		galerie.length > 0 && (
			<section class="sekce" id="galerie">
				<div class="obsah">
					<p class="nadpis-sekce">Fotografie</p>
					<h2>Prohlídka</h2>
					<div class="galerie">
						{galerie.map((fotka, index) => (
							<figure class="galerie__polozka">
								{/* poměr stran drží CSS, fotky jsou na výšku i na šířku */}
								<img
									src={`/fotky/${fotka.soubor}`}
									alt={fotka.popis}
									loading={index === 0 ? 'eager' : 'lazy'}
								/>
								<figcaption>{fotka.popis}</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<Pozemky />

	<section class="sekce sekce--tlumena" id="lokalita">
		<div class="obsah">
			<p class="nadpis-sekce">Okolí</p>
			<h2>Lokalita</h2>
			<p class="lokalita__popis">{lokalita.popis}</p>
			<ul class="vzdalenosti">
				{
					lokalita.vzdalenosti.map((polozka) => (
						<li>
							<span>{polozka.misto}</span>
							<strong>{polozka.hodnota}</strong>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="sekce" id="kontakt">
		<div class="obsah">
			<p class="nadpis-sekce">Máte zájem?</p>
			<h2>Kontakt přímo na majitele</h2>
			<p class="kontakt">
				{kontakt.jmeno}<br />
				<a href={telefonHref}>{kontakt.telefon}</a><br />
				<a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
			</p>
			<p class="kontakt__poznamka">
				Dům prodávám sám, bez realitní kanceláře — ozvěte se mi přímo.
			</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
		border-bottom: 1px solid var(--barva-linka);
	}

	.hero__media {
		position: relative;
	}

	.hero__foto {
		display: block;
		width: 100%;
		height: clamp(21rem, 66vh, 38rem);
		object-fit: cover;
	}

	/* Ztmavení jde jen zespodu a nahoře doběhne do průhledna, aby fotka
	   zůstala fotkou a text na ní přesto držel kontrast. */
	.hero__titulek {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding-block: clamp(4rem, 12vh, 7rem) clamp(1.5rem, 4vh, 2.5rem);
		background: linear-gradient(to top, rgba(16, 14, 11, 0.74), rgba(16, 14, 11, 0.4) 45%, transparent);
	}

	.hero__titulek h1 {
		color: #fff;
	}

	.hero__titulek .nadpis-sekce {
		color: rgba(255, 255, 255, 0.85);
		margin-bottom: 0.5rem;
	}

	.hero__perex {
		max-width: 42rem;
		margin-top: clamp(2rem, 5vw, 3rem);
		font-size: 1.125rem;
		color: var(--barva-text-tlumena);
	}

	.parametry {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1.5rem 2rem;
		margin: 0;
	}

	.parametry__polozka {
		border-top: 1px solid var(--barva-linka);
		padding-top: 0.75rem;
	}

	.parametry dt {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	.parametry dd {
		margin: 0.25rem 0 0;
		font-family: var(--pismo);
		font-size: 1.375rem;
	}

	.rozlozeni {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		max-width: 44rem;
	}

	.rozlozeni li {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--barva-linka);
	}

	.rozlozeni span {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
		padding-top: 0.15rem;
	}

	.rozlozeni strong {
		font-weight: 400;
	}

	.galerie {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: 1.5rem;
	}

	.galerie__polozka {
		margin: 0;
	}

	.galerie__polozka img {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		background: var(--barva-pozadi-blok);
		border-radius: 2px;
	}

	.galerie figcaption {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		color: var(--barva-text-tlumena);
	}

	.lokalita__popis {
		max-width: 42rem;
		margin-top: 0;
	}

	.vzdalenosti {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		max-width: 32rem;
	}

	.vzdalenosti li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--barva-linka);
	}

	.kontakt {
		font-size: 1.125rem;
	}

	.kontakt__poznamka {
		color: var(--barva-text-tlumena);
		max-width: 34rem;
	}
</style>

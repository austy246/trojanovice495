---
/*
 * Schéma podlaží, jaké bývá v realitních nabídkách: světlé plochy místností
 * s názvem a výměrou, mezi nimi tmavé zdi. Geometrie je v src/data/pudorys.ts,
 * názvy a plochy se berou z rozpisu v nemovitost.ts podle čísla místnosti.
 *
 * Každá místnost nese data-m se svým číslem; totéž mají položky v seznamu
 * ploch. Kdo je zvýrazňuje a jak, řeší skript v PlochyMistnosti.astro —
 * schéma samo jen kreslí a nabízí místnosti k najetí, Tabu a kliknutí.
 * Nad schématem je karta s nadpisem a řádkem, do kterého tentýž skript
 * dopisuje zvýrazněnou místnost: na telefonu jsou v místnostech jen čísla,
 * název a plocha se čtou z karty.
 */
import { nemovitost } from '../data/nemovitost';
import type { Bod, PudorysSchema } from '../data/pudorys';

interface Props {
	schema: PudorysSchema;
	/** název podlaží do přístupového popisku */
	podlazi: string;
}

const { schema, podlazi } = Astro.props;

const rozpis = new Map(
	nemovitost.plochy.flatMap((p) => p.mistnosti).map((m) => [m.cislo, m] as const),
);

/** stejná sazba čísla jako v seznamu vedle, ať se schéma a seznam dají srovnat od oka */
const cislo = (n: number) => n.toFixed(2).replace('.', ',');
const body = (b: Bod[]) => b.map((p) => p.join(',')).join(' ');

const mistnosti = schema.mistnosti.map((m) => {
	const r = rozpis.get(m.cislo);
	if (!r) throw new Error(`Místnost ${m.cislo} ve schématu není v rozpisu ploch`);
	return { ...m, nazev: r.nazev, plocha: r.plocha };
});

const [vx, vy, vs, vv] = schema.viewBox;

/* schodiště se kreslí jako vodorovné pruhy, stupně od spodní hrany nahoru */
const s = schema.schodiste;
const stupne = Array.from({ length: s.stupnu - 1 }, (_, i) => s.y + ((i + 1) * s.vyska) / s.stupnu);

/*
 * Dveře. Otvor je obdélník kolem osy zdi o něco silnější než zeď — přesah
 * do místností zakryjí jejich plochy, které se kreslí až po něm. Křídlo
 * a oblouk se kreslí nad místnostmi: křídlo stojí kolmo na zeď v závěsu,
 * oblouk jde od jeho konce k druhé zárubni. Posuvné mají křídlo odsunuté
 * vedle zdi, nebo kapsu ve zdi a křídlo napůl zasunuté, když do ní
 * zajíždějí; pevné zasklení čáru v ose zdi, průchod jen otvor.
 */
const dvere = schema.dvere.map((d) => {
	const [ax, ay] = d.od;
	const [bx, by] = d.do;
	const dx = bx - ax;
	const dy = by - ay;
	const delka = Math.hypot(dx, dy);
	/* normála vlevo od směru od→do (osa y roste dolů) */
	const nx = dy / delka;
	const ny = -dx / delka;
	const s = d.strana === 'vpravo' ? -1 : 1;
	const pul = (d.sila ?? 12) / 2 + 3;
	const otvor: Bod[] = [
		[ax + nx * pul, ay + ny * pul],
		[bx + nx * pul, by + ny * pul],
		[bx - nx * pul, by - ny * pul],
		[ax - nx * pul, ay - ny * pul],
	];
	const typ = d.typ ?? 'kridlove';
	const kridlo: Bod = [ax + s * nx * delka, ay + s * ny * delka];
	/* oblouk od konce křídla k zárubni; vlevo je po směru hodin, vpravo proti */
	const oblouk = `M ${kridlo[0]} ${kridlo[1]} A ${delka} ${delka} 0 0 ${s > 0 ? 1 : 0} ${bx} ${by}`;
	const odsazeni = 9;
	const posuv: [Bod, Bod] = [
		[ax + dx * 0.1 + s * nx * odsazeni, ay + dy * 0.1 + s * ny * odsazeni],
		[bx + dx * 0.9 + s * nx * odsazeni, by + dy * 0.9 + s * ny * odsazeni],
	];
	/* kapsa ve zdi za druhou zárubní, stejně dlouhá jako otvor; křídlo je napůl zasunuté */
	const kapsa: Bod[] = [
		[bx + nx * 3, by + ny * 3],
		[bx + dx + nx * 3, by + dy + ny * 3],
		[bx + dx - nx * 3, by + dy - ny * 3],
		[bx - nx * 3, by - ny * 3],
	];
	const zasunute: [Bod, Bod] = [
		[ax + dx * 0.5, ay + dy * 0.5],
		[bx + dx * 0.5, by + dy * 0.5],
	];
	return { typ, doZdi: d.doZdi, otvor, kridlo, oblouk, posuv, kapsa, zasunute, od: d.od, do: d.do };
});

/* okno: světlý pruh přesně v síle zdi, s čarou skla v ose; kreslí se až nad místnostmi */
const okna = schema.okna.map((o) => {
	const [ax, ay] = o.od;
	const [bx, by] = o.do;
	const dx = bx - ax;
	const dy = by - ay;
	const delka = Math.hypot(dx, dy);
	const nx = dy / delka;
	const ny = -dx / delka;
	const pul = (o.sila ?? 30) / 2;
	const pruh: Bod[] = [
		[ax + nx * pul, ay + ny * pul],
		[bx + nx * pul, by + ny * pul],
		[bx - nx * pul, by - ny * pul],
		[ax - nx * pul, ay - ny * pul],
	];
	return { pruh, od: o.od, do: o.do };
});

const { krb, vstup } = schema;
const otvory = schema.otvory ?? [];
const prostory = schema.prostory ?? [];
const skrine = schema.skrine ?? [];
const stresniOkna = schema.stresniOkna ?? [];
/* šrafa otvoru v podlaze; id musí být v dokumentu jedinečné, schémat je víc */
const srafa = `srafa-${podlazi.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<figure class="pudorys">
	<div class="karta">
		<p class="karta__nadpis">Schéma {podlazi.toLowerCase()}</p>
		{/* prvky jsou v šabloně, ne ze skriptu: jen tak na ně dosáhnou zdejší styly */}
		<p class="karta__mistnost" aria-live="polite">
			<span class="karta__nazev"><span class="karta__cislo"></span><span class="karta__jmeno"></span></span>
			<strong class="karta__plocha"></strong>
		</p>
	</div>
	<svg
		viewBox={`${vx} ${vy} ${vs} ${vv}`}
		role="group"
		aria-label={`Schéma podlaží ${podlazi}`}
	>
		{
			schema.terasy.map((t) => (
				<g class="terasa">
					<polygon points={body(t.body)} />
					{!t.jenObrys && (
					<text class="popisek" x={t.popisek[0]} y={t.popisek[1]} text-anchor="middle">
						<tspan class="popisek__cislo" x={t.popisek[0]} dy="-1.1em">
							{t.cislo}
						</tspan>
						<tspan class="popisek__nazev" x={t.popisek[0]} dy="1.15em">
							{t.nazev}
						</tspan>
						{t.plocha !== undefined && (
							<tspan class="popisek__plocha" x={t.popisek[0]} dy="1.15em">
								{cislo(t.plocha)} m²
							</tspan>
						)}
					</text>
					)}
				</g>
			))
		}

		{/* obvodové zdi: tmavý obrys domu, ze kterého místnosti níž vykrojí světlé plochy */}
		<polygon class="zdi" points={body(schema.obrys)} />
		{dvere.map((d) => <polygon class="otvor" points={body(d.otvor)} />)}
		{dvere.filter((d) => d.doZdi).map((d) => <polygon class="otvor" points={body(d.kapsa)} />)}

		{
			mistnosti.map((m) => (
				<g
					class="mistnost"
					data-m={m.cislo}
					data-nazev={m.nazev}
					data-plocha={`${cislo(m.plocha)} m²`}
					tabindex="0"
					role="button"
					aria-label={`${m.cislo} ${m.nazev}, ${cislo(m.plocha)} m²`}
				>
					<polygon points={body(m.body)} />
					<text
						class:list={['popisek', { 'popisek--jen-cislo': m.jenCislo }]}
						x={m.popisek[0]}
						y={m.popisek[1]}
						text-anchor="middle"
					>
						<tspan class="popisek__cislo" x={m.popisek[0]} dy={m.jenCislo ? '0.35em' : '-1.1em'}>
							{m.cislo}
						</tspan>
						{!m.jenCislo && (
							<>
								<tspan class="popisek__nazev" x={m.popisek[0]} dy="1.15em">
									{m.nazev}
								</tspan>
								<tspan class="popisek__plocha" x={m.popisek[0]} dy="1.15em">
									{cislo(m.plocha)} m²
								</tspan>
							</>
						)}
					</text>
				</g>
			))
		}

		{
			prostory.map((p) => (
				<g class="prostor" aria-label={p.nazev}>
					<polygon points={body(p.body)} />
					<text class="popisek" x={p.popisek[0]} y={p.popisek[1]} text-anchor="middle">
						<tspan class="popisek__nazev" x={p.popisek[0]} dy="0.35em">
							{p.nazev}
						</tspan>
					</text>
				</g>
			))
		}

		{/* otvor v podlaze: světlý podklad se šrafou místo plochy, ať nevypadá jako podlaha ani jako zeď */}
		{
			otvory.length > 0 && (
				<defs>
					<pattern id={srafa} patternUnits="userSpaceOnUse" width="14" height="14" patternTransform="rotate(45)">
						<line class="srafa" x1="0" y1="0" x2="0" y2="14" />
					</pattern>
				</defs>
			)
		}
		{
			otvory.map((o) => (
				<g class="otvor-dolu" aria-label={o.radky.join(' ')}>
					<polygon class="otvor-dolu__podklad" points={body(o.body)} />
					<polygon class="otvor-dolu__srafa" points={body(o.body)} fill={`url(#${srafa})`} />
					<polygon class="otvor-dolu__obrys" points={body(o.body)} />
					<text class="popisek" x={o.popisek[0]} y={o.popisek[1]} text-anchor="middle">
						{o.radky.map((r, i) => (
							<tspan x={o.popisek[0]} dy={i === 0 ? `${0.35 - (o.radky.length - 1) * 0.575}em` : '1.15em'}>
								{r}
							</tspan>
						))}
					</text>
				</g>
			))
		}

		<g class="dvere" aria-hidden="true">
			{
				dvere.map((d) =>
					d.typ === 'kridlove' ? (
						<>
							<line x1={d.od[0]} y1={d.od[1]} x2={d.kridlo[0]} y2={d.kridlo[1]} />
							<path d={d.oblouk} />
						</>
					) : d.typ === 'posuvne' && d.doZdi ? (
						<line class="posuvne" x1={d.zasunute[0][0]} y1={d.zasunute[0][1]} x2={d.zasunute[1][0]} y2={d.zasunute[1][1]} />
					) : d.typ === 'posuvne' ? (
						<line class="posuvne" x1={d.posuv[0][0]} y1={d.posuv[0][1]} x2={d.posuv[1][0]} y2={d.posuv[1][1]} />
					) : d.typ === 'pevne' ? (
						<line x1={d.od[0]} y1={d.od[1]} x2={d.do[0]} y2={d.do[1]} />
					) : null,
				)
			}
		</g>

		<g class="okna" aria-hidden="true">
			{
				okna.map((o) => (
					<>
						<polygon points={body(o.pruh)} />
						<line x1={o.od[0]} y1={o.od[1]} x2={o.do[0]} y2={o.do[1]} />
					</>
				))
			}
		</g>

		<g class="skrine" aria-hidden="true">
			{
				skrine.map((k) => (
					<>
						<rect x={k.x} y={k.y} width={k.sirka} height={k.vyska} />
						<line x1={k.x} y1={k.y + k.vyska} x2={k.x + k.sirka} y2={k.y} />
					</>
				))
			}
		</g>

		<g class="stresni-okna" aria-hidden="true">
			{
				stresniOkna.map((o) => (
					<>
						<rect x={o.x} y={o.y} width={o.sirka} height={o.vyska} />
						<line x1={o.x} y1={o.y + o.vyska / 2} x2={o.x + o.sirka} y2={o.y + o.vyska / 2} />
					</>
				))
			}
		</g>

		{
			krb && (
				<g class="krb" aria-label="Krb">
					<rect class="krb__teleso" x={krb.x} y={krb.y} width={krb.sirka} height={krb.hloubka} />
					<rect
						class="krb__vlozka"
						x={krb.x + krb.sirka * 0.2}
						y={krb.y + krb.hloubka * 0.45}
						width={krb.sirka * 0.6}
						height={krb.hloubka * 0.55}
					/>
					<path
						class="krb__ohniste"
						d={`M ${krb.x + krb.sirka / 2 - krb.ohniste} ${krb.y + krb.hloubka} A ${krb.ohniste} ${krb.ohniste} 0 0 0 ${krb.x + krb.sirka / 2 + krb.ohniste} ${krb.y + krb.hloubka}`}
					/>
					<text x={krb.x + krb.sirka / 2} y={krb.y + krb.hloubka + krb.ohniste * 0.72} text-anchor="middle">
						Krb
					</text>
				</g>
			)
		}

		<g class="schodiste" aria-hidden="true">
			<rect x={s.x} y={s.y} width={s.sirka} height={s.vyska} />
			{stupne.map((y) => (
				<line x1={s.x} y1={y} x2={s.x + s.sirka} y2={y} />
			))}
		</g>

		{
			vstup && (
				<g class="vstup" aria-hidden="true">
					<line x1={vstup.x} y1={vstup.y - 62} x2={vstup.x} y2={vstup.y - 10} />
					<polygon
						points={`${vstup.x - 9},${vstup.y - 24} ${vstup.x + 9},${vstup.y - 24} ${vstup.x},${vstup.y - 6}`}
					/>
					<text x={vstup.x} y={vstup.y - 74} text-anchor="middle">
						Vstup
					</text>
				</g>
			)
		}
	</svg>
	<figcaption>
		<slot />
	</figcaption>
</figure>

<style>
	.pudorys {
		margin: 0;
		/* popisky se přepínají podle šířky schématu, ne okna — schémata stojí i dvě vedle sebe */
		container-type: inline-size;
	}

	.pudorys svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--pismo-ui);
	}

	/*
	 * Karta nad schématem: nadpis a řádek pro zvýrazněnou místnost. Řádek má
	 * výšku pořád, i prázdný, aby schéma pod ním při klepnutí neposkočilo.
	 * Když je v něm místnost, karta se zbarví stejnou modrou jako místnost.
	 */
	.karta {
		margin: 0 0 0.75rem;
		padding: 0.6rem 0.9rem 0.65rem;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: var(--barva-pozadi);
		transition: background 0.12s, border-color 0.12s;
	}

	.karta.je-vybrana {
		border-color: color-mix(in srgb, var(--barva-nabidka-vybrana) 45%, var(--barva-linka));
		background: color-mix(in srgb, var(--barva-nabidka-vybrana) 10%, var(--barva-pozadi));
	}

	.karta__nadpis {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	.karta__mistnost {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		min-height: 1.5em;
		margin: 0.15rem 0 0;
		font-size: 1.125rem;
		line-height: 1.5;
	}

	/*
	 * Popis místnosti se neobjeví skokem: krátce se prolne a vysune zdola.
	 * Animace startuje s třídou je-vybrana, takže při přechodu z jedné
	 * místnosti na druhou (třída se sundá a nasadí) běží znovu.
	 */
	.karta.je-vybrana .karta__mistnost {
		animation: karta-objeveni 0.28s ease-out both;
	}

	@keyframes karta-objeveni {
		from {
			opacity: 0;
			transform: translateY(0.35em);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.karta.je-vybrana .karta__mistnost {
			animation: none;
		}
	}

	.karta__cislo {
		margin-right: 0.5rem;
		color: var(--barva-text-tlumena);
		font-variant-numeric: tabular-nums;
	}

	.karta__plocha {
		font-weight: 500;
		white-space: nowrap;
	}

	/*
	 * Zdi nevznikají čarou, ale tím, co zbude: tmavý obrys domu pod světlými
	 * plochami místností. Mezera mezi dvěma místnostmi je zeď, sdílená hrana
	 * průchod. Obrys je o něco měkčí než text, aby při síle obvodové zdi
	 * nepřebil popisky.
	 */
	.zdi {
		fill: #3d372f;
	}

	.otvor,
	.mistnost polygon {
		fill: var(--barva-pozadi);
	}

	.dvere {
		pointer-events: none;
	}

	.dvere line,
	.dvere path {
		fill: none;
		stroke: var(--barva-text-tlumena);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.dvere .posuvne {
		stroke-width: 5;
	}

	.mistnost polygon {
		transition: fill 0.12s;
	}

	/*
	 * Stejná modrá a stejné tři stupně jako v mapě pozemků: najetí lehce,
	 * vybraná místnost víc a jiným odstínem, aby se výběr nepletl s najetím.
	 */
	.mistnost {
		cursor: pointer;
		outline: none;
	}

	.mistnost:hover polygon,
	.mistnost:focus-visible polygon {
		fill: color-mix(in srgb, var(--barva-nabidka) 17%, var(--barva-pozadi));
	}

	.mistnost.je-zvyraznena polygon,
	.mistnost.je-zvyraznena:hover polygon {
		fill: color-mix(in srgb, var(--barva-nabidka-vybrana) 28%, var(--barva-pozadi));
	}

	/* prostor bez čísla: světlá plocha jako místnost, ale bez najetí a bez čísla */
	.prostor polygon {
		fill: var(--barva-pozadi);
	}

	.prostor .popisek {
		fill: var(--barva-text-tlumena);
	}

	/*
	 * Otvor v podlaze: světlý podklad jako u místností, přes něj řídká šrafa
	 * tlumenou barvou a tenký obrys. Tmavá výplň by vedle zdí působila jako
	 * masiv; takhle je to podlaha, která tam není.
	 */
	.otvor-dolu {
		pointer-events: none;
	}

	.otvor-dolu__podklad {
		fill: var(--barva-pozadi);
	}

	/* čára šrafy leží v defs mimo skupinu otvoru, proto má vlastní třídu */
	.srafa {
		stroke: var(--barva-text-tlumena);
		stroke-width: 1.5;
		opacity: 0.35;
	}

	.otvor-dolu__obrys {
		fill: none;
		stroke: var(--barva-text-tlumena);
		stroke-width: 2;
		opacity: 0.6;
	}

	.otvor-dolu .popisek {
		fill: var(--barva-text-tlumena);
		font-size: 21px;
		paint-order: stroke;
		stroke: var(--barva-pozadi);
		stroke-width: 6;
		stroke-linejoin: round;
	}

	.skrine,
	.stresni-okna {
		pointer-events: none;
	}

	.skrine rect,
	.skrine line {
		fill: none;
		stroke: var(--barva-text-tlumena);
		stroke-width: 1.5;
		opacity: 0.7;
	}

	.stresni-okna rect,
	.stresni-okna line {
		fill: none;
		stroke: var(--barva-text-tlumena);
		stroke-width: 1.5;
		stroke-dasharray: 6 5;
		opacity: 0.8;
	}

	.terasa polygon {
		fill: color-mix(in srgb, var(--barva-pozadi) 55%, transparent);
		stroke: var(--barva-text-tlumena);
		stroke-width: 3;
		stroke-dasharray: 14 10;
	}

	.terasa .popisek {
		fill: var(--barva-text-tlumena);
	}

	/*
	 * Písmo je v jednotkách výřezu, takže se zmenšuje se schématem. Ve sloupci
	 * nad seznamem vychází název na zhruba 11 px; na telefonu by z něj zbylo
	 * 6 px, proto tam zůstane jen číslo místnosti, zvětšené — jméno a plochu
	 * čtenář najde v seznamu hned pod schématem.
	 */
	.popisek {
		fill: var(--barva-text);
		font-size: 24px;

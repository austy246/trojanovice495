---
import Layout from '../layouts/Layout.astro';
import Pozemky from '../components/Pozemky.astro';
import Nakresy from '../components/Nakresy.astro';
import PlochyMistnosti from '../components/PlochyMistnosti.astro';
import Cena from '../components/Cena.astro';
import { existsSync, statSync } from 'node:fs';
import { resolve } from 'node:path';
import { energie, nemovitost } from '../data/nemovitost';
import { spolecne, telefonHref } from '../data/spolecne';

const { nazev, podtitul, perex, cena, cenaPoznamka, uvodniFoto, parametry, rozlozeni, galerie } =
	nemovitost;
const { lokalita, kontakt } = spolecne;

const cisloCZ = new Intl.NumberFormat('cs-CZ');

/*
 * Odkaz na průkaz se ukáže, jen když soubor v public/ opravdu leží. Mrtvý
 * odkaz ke stažení je horší než žádný, a tohle se pozná při buildu.
 */
const cestaPrukazu = resolve(process.cwd(), `public${energie.prukaz.soubor}`);
const maPrukaz = existsSync(cestaPrukazu);

/** U odkazu ke stažení patří velikost — ať člověk ví, do čeho jde, než klikne. */
const velikostPrukazu = maPrukaz
	? `${(statSync(cestaPrukazu).size / 1024 / 1024).toFixed(1).replace('.', ',')} MB`
	: '';
---

<Layout titulek={`${nazev} — ${podtitul}`} popis={perex}>
	<header class="hero">
		<div class="hero__media">
			<picture>
				<source media="(max-width: 60rem)" srcset={`/fotky/${uvodniFoto.souborNaVysku}`} />
				<img class="hero__foto" src={`/fotky/${uvodniFoto.soubor}`} alt={uvodniFoto.popis} fetchpriority="high" />
			</picture>
			<div class="hero__titulek">
				<div class="obsah">
					<p class="nadpis-sekce">{podtitul}</p>
					<h1>{nazev}</h1>
				</div>
			</div>
		</div>

		<div class="obsah">
			<p class="hero__perex">{perex}</p>
			<Cena cena={cena} poznamka={cenaPoznamka} />
		</div>
	</header>

	<section class="sekce sekce--tlumena" id="parametry">
		<div class="obsah">
			<p class="nadpis-sekce">Přehled</p>
			<h2>Základní parametry</h2>
			<dl class="parametry">
				{
					parametry.map((polozka) => (
						<div class="parametry__polozka">
							<dt>{polozka.nazev}</dt>
							<dd>{polozka.hodnota}</dd>
						</div>
					))
				}
			</dl>

			<ul class="rozlozeni">
				{
					rozlozeni.map((podlazi) => (
						<li>
							<span>{podlazi.podlazi}</span>
							<strong>{podlazi.mistnosti}</strong>
						</li>
					))
				}
			</ul>

			<div class="provoz">
				<p class="stitek">
					<span class="stitek__trida">{energie.trida}</span>
					Energetická třída {energie.trida} — {energie.tridaSlovy}
				</p>
				<p class="provoz__text">
					Dům je celý na elektřině — tepelné čerpadlo země-voda topí i ohřívá vodu,
					vaří se také elektřinou. Plyn zaveden není a voda teče z vlastní studny,
					takže měsíčně odchází <strong>{cisloCZ.format(energie.mesicne)} Kč za elektřinu</strong>
					{' '}a nic dalšího.
				</p>
				<p class="provoz__prukaz">
					Průkaz energetické náročnosti ev.&nbsp;č. {energie.prukaz.evidencni}, vyhotovil
					{' '}{energie.prukaz.specialista} {energie.prukaz.vyhotoven}, platný do {energie.prukaz.platnyDo}.
					{
						maPrukaz && (
							<>
								{' '}
								<a href={energie.prukaz.soubor} download>Stáhnout průkaz (PDF, {velikostPrukazu})&nbsp;↓</a>
							</>
						)
					}
				</p>
			</div>
		</div>
	</section>

	{
		galerie.length > 0 && (
			<section class="sekce" id="galerie">
				<div class="obsah">
					<p class="nadpis-sekce">Fotografie</p>
					<h2>Prohlídka</h2>
					<div class="galerie">
						{galerie.map((fotka, index) => (
							<figure class="galerie__polozka">
								{/* poměr stran drží CSS, fotky jsou na výšku i na šířku */}
								<img
									src={`/fotky/${fotka.soubor}`}
									alt={fotka.popis}
									loading={index === 0 ? 'eager' : 'lazy'}
								/>
								<figcaption>{fotka.popis}</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<PlochyMistnosti />

	<Nakresy />

	<Pozemky />

	<section class="sekce sekce--tlumena" id="lokalita">
		<div class="obsah">
			<p class="nadpis-sekce">Okolí</p>
			<h2>Lokalita</h2>
			<p class="lokalita__popis">{lokalita.popis}</p>
			<ul class="vzdalenosti">
				{
					lokalita.vzdalenosti.map((polozka) => (
						<li>
							<span>{polozka.misto}</span>
							<strong>{polozka.hodnota}</strong>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="sekce" id="kontakt">
		<div class="obsah">
			<p class="nadpis-sekce">Máte zájem?</p>
			<h2>Kontakt přímo na majitele</h2>
			<p class="kontakt">
				{kontakt.jmeno}<br />
				<a href={telefonHref}>{kontakt.telefon}</a><br />
				<a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
			</p>
			<p class="kontakt__poznamka">
				Prodávám sám, bez realitní kanceláře — ozvěte se mi přímo. Dům i háječek se
				prodávají dohromady, jako jeden celek.
			</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
		border-bottom: 1px solid var(--barva-linka);
	}

	.hero__media {
		position: relative;
	}

	.hero__media picture {
		display: block;
	}

	.hero__foto {
		display: block;
		width: 100%;
		height: clamp(21rem, 66vh, 38rem);
		object-fit: cover;
		/*
		 * Nižší hodnota ukazuje horní část fotky a tlačí dům v záběru dolů
		 * k nadpisu, vyšší ho zvedá a přidává trávu pod ním. Hřeben střechy
		 * je ve 32 % výšky fotky; 45 % ho na běžných šířkách okna nechá
		 * těsně u horní hrany a pod nadpisem udrží travnatý pás.
		 */
		object-position: 50% 45%;
	}

	/* varianta na výšku je oříznutá už v souboru, stačí ji držet u středu */
	@media (max-width: 60rem) {
		.hero__foto {
			object-position: 50% 50%;
		}
	}

	/* Ztmavení jde jen zespodu a nahoře doběhne do průhledna, aby fotka
	   zůstala fotkou a text na ní přesto držel kontrast. */
	.hero__titulek {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding-block: clamp(4rem, 12vh, 7rem) clamp(1.5rem, 4vh, 2.5rem);
		background: linear-gradient(to top, rgba(16, 14, 11, 0.74), rgba(16, 14, 11, 0.4) 45%, transparent);
	}

	.hero__titulek h1 {
		color: #fff;
	}

	.hero__titulek .nadpis-sekce {
		color: rgba(255, 255, 255, 0.85);
		margin-bottom: 0.5rem;
	}

	.hero__perex {
		max-width: 42rem;
		margin-top: clamp(2rem, 5vw, 3rem);
		font-size: 1.125rem;
		color: var(--barva-text-tlumena);
	}

	.parametry {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1.5rem 2rem;
		margin: 0;
	}

	.parametry__polozka {
		border-top: 1px solid var(--barva-linka);
		padding-top: 0.75rem;
	}

	.parametry dt {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--barva-text-tlumena);
	}

	.parametry dd {
		margin: 0.25rem 0 0;
		font-family: var(--pismo);
		font-size: 1.375rem;
	}

	.rozlozeni {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		max-width: 44rem;
	}

	/*
	 * Provozní náklady. Nedělá se z nich vlastní ostrůvek s rámečkem a jiným
	 * pozadím — v sekci už je rozpiska i rozložení podlaží a třetí krabice by
	 * působila jako cizí prvek. Drží se proto stejné vodorovné linky jako
	 * položky přehledu nad ní.
	 */
	.provoz {
		margin: 2.5rem 0 0;
		max-width: 44rem;
		border-top: 1px solid var(--barva-linka);
		padding-top: 1.25rem;
	}

	/*
	 * Štítek energetické třídy. Písmeno je jediné, co jde porovnat napříč
	 * inzeráty, tak ať je vidět — zelená je ale ztlumená do teplé palety webu,
	 * aby vedle krémového podkladu nekřičela.
	 */
	.stitek {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 0.9rem;
		padding: 0.3rem 0.8rem 0.3rem 0.35rem;
		border: 1px solid var(--barva-linka);
		border-radius: 999px;
		background: var(--barva-pozadi);
		font-family: var(--pismo-ui);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		color: var(--barva-text-tlumena);
	}

	.stitek__trida {
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 999px;
		background: #3f7d54;
		color: #fff;
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0;
	}

	.provoz__text {
		margin: 0;
		max-width: 42rem;
		line-height: 1.7;
	}

	.provoz__prukaz {
		margin: 0.7rem 0 0;
		max-width: 42rem;
		color: var(--barva-text-tlumena);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	.lokalita__popis {
		max-width: 42rem;
		margin-top: 0;
	}

	.vzdalenosti {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		max-width: 32rem;
	}

	.vzdalenosti li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--barva-linka);
	}

	.kontakt {
		font-size: 1.125rem;
	}

	.kontakt__poznamka {
		color: var(--barva-text-tlumena);
		max-width: 34rem;
	}
</style>

---
import { parcely, pozemekUDomu, VYREZY } from '../data/parcely';

interface Props {
	/** který výřez se vykresluje */
	varianta: 'prehled' | 'detail';
	/** popisek pod mapou, slouží zároveň jako přístupový název */
	popis: string;
}

const { varianta, popis } = Astro.props;

const jeNase = (p: (typeof parcely)[number]) => Boolean(p.cast);

/*
 * Kreslí se vždy všechny parcely — soused je užitečný kontext. Ty mimo
 * nabídku ale dostanou třídu je-mimo: ztlumené, bez kliknutí i bez Tabu.
 */
const trida = (p: (typeof parcely)[number]) => {
	const zaklad = p.stavebni ? 'je-st' : 'je-poz';
	return jeNase(p) ? zaklad : `${zaklad} je-mimo`;
};
const vyrez = VYREZY[varianta];
const viewBox = `0 0 ${vyrez.sirka} ${vyrez.vyska}`;
const pomer = ((vyrez.vyska / vyrez.sirka) * 100).toFixed(3);

/*
 * Obě mapy se skládají stejně: ortofoto ČÚZK a nad ním katastrální kresba jako
 * samostatná průhledná vrstva. Oboje generuje scripts/podklady.mjs.
 */
const jeDetail = varianta === 'detail';

const pozemek = pozemekUDomu[varianta];
---

<figure class="mapa-fig">
	<div class="mapa" data-mapa={varianta} data-sirka={vyrez.sirka}>
		<div class="mapa__pomer" style={`padding-top:${pomer}%`}></div>

		<div class="mapa__scena">
			<picture>
				<source srcset={`/katastr/${varianta}-orto.avif`} type="image/avif" />
				<img
					class="mapa__vrstva mapa__orto"
					src={`/katastr/${varianta}-orto.webp`}
					alt="Ortofoto ČÚZK"
					draggable="false"
					loading="lazy"
				/>
			</picture>

			<svg class="mapa__vrstva mapa__vyplne" viewBox={viewBox} preserveAspectRatio="none" aria-hidden="true">
				{
					parcely.map((p) => (
						<path class={`vyplen ${trida(p)}`} data-p={p.cislo} d={p[varianta].d} />
					))
				}

				{/*
				 * Vymezený pozemek u domu se v katastru zatím nekreslí, tady ale
				 * plochu nabídky nese — obě stavební parcely u domu leží uvnitř něj.
				 */}
				<path class="vyplen je-pozemek" d={pozemek.d} />
			</svg>

			<img
				class="mapa__vrstva mapa__km"
				src={`/katastr/${varianta}-kresba.webp`}
				alt="Katastrální mapa ČÚZK"
				draggable="false"
				loading="lazy"
			/>

			<svg class="mapa__vrstva" viewBox={viewBox} preserveAspectRatio="none" role="img" aria-label={popis}>
				{
					parcely.map((p) => (
						<path
							class={`obrys ${trida(p)}`}
							data-p={p.cislo}
							d={p[varianta].d}
							tabindex={jeNase(p) ? '0' : undefined}
							role={jeNase(p) ? 'button' : undefined}
							aria-hidden={jeNase(p) ? undefined : 'true'}
							aria-label={jeNase(p) ? `${p.cislo}, ${p.vymera} m², ${p.druh}` : undefined}
						>
							{jeNase(p) && <title>{`${p.cislo} · ${p.vymera} m² · ${p.druh}`}</title>}
						</path>
					))
				}
				<path class="pozemek" d={pozemek.d} />

				{/*
				 * Popisky nese jen nabídka. Čísla ostatních parcel má vypálená
				 * podklad a druhý popisek přes ně by je jen ztížil.
				 *
				 * V detailu se kreslí ještě míň — jen stavební parcely: podklad je
				 * uvádí bez předpony „St.“ a v této mapě jsou to ty, na kterých záleží.
				 */}
				<g class="mapa__popisky">
					{
						parcely
							.filter((p) => jeNase(p) && (jeDetail ? p.stavebni : true))
							.map((p) => (
								<g class="popisek" data-p={p.cislo} data-fit={p[varianta].fit}>
									<text x={p[varianta].x} y={p[varianta].y} class="halo">
										{p.cislo}
									</text>
									<text x={p[varianta].x} y={p[varianta].y}>
										{p.cislo}
									</text>
								</g>
							))
					}
				</g>
			</svg>
		</div>

		<div class="mapa__sever" aria-hidden="true">S</div>
		<div class="mapa__meritko" data-podil={vyrez.meritkoPodil}>
			<i></i>
			<span data-meritko={vyrez.meritko}>{vyrez.meritko} m</span>
		</div>
		<div class="mapa__zoom">
			<button type="button" data-z="in" aria-label="Přiblížit">+</button>
			<button type="button" data-z="out" aria-label="Oddálit">−</button>
			<button type="button" data-z="reset" aria-label="Zpět na celý výřez">⟲</button>
		</div>
	</div>
	<figcaption>{popis}</figcaption>
</figure>

<style>
	.mapa-fig {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.mapa-fig figcaption {
		color: var(--barva-text-tlumena);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	/*
	 * --u = kolik pixelů displeje připadá na jednotku viewBoxu. Obrysy i popisky
	 * se jím dělí, takže při zvětšení drží stálou tloušťku a velikost.
	 */
	.mapa {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: #0c0e0c;
		line-height: 0;
		touch-action: pan-y;
		cursor: grab;
		--u: 0.25;
	}

	.mapa.je-zvetsena {
		touch-action: none;
	}

	.mapa.je-tazena {
		cursor: grabbing;
	}

	.mapa__pomer {
		width: 100%;
	}

	.mapa__scena {
		position: absolute;
		inset: 0;
		transform-origin: 0 0;
		will-change: transform;
	}

	.mapa__vrstva {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		user-select: none;
	}

	/*
	 * Katastrální kresba je podklad, ne sdělení. Bílá se proto ještě ztlumí,
	 * aby hranice a čísla byly čitelné, když je člověk hledá, ale nepřetahovaly
	 * pozornost z modré nabídky, když je nehledá.
	 */
	.mapa__km {
		opacity: 0.55;
	}

	/*
	 * Barvu výplně a barvu obrysu drž v oddělených pravidlech. Sloučené
	 * `.vyplen.je-st, .obrys.je-st { fill: … }` má vyšší specificitu než
	 * `.obrys { fill: none }` a obarvilo by i obrysovou vrstvu, která žádnou
	 * průhlednost nemá — parcely by přes ortofoto vyšly jako plné plochy.
	 */
	/*
	 * Nabízené pozemky jsou modré; stavební parcely jen sytěji, protože jsou
	 * drobné a proti ortofotu by se ztratily.
	 */
	.vyplen {
		stroke: none;
		fill: var(--barva-nabidka);
		fill-opacity: 0.14;
	}

	.vyplen.je-st {
		fill: var(--barva-nabidka-syta);
		fill-opacity: 0.42;
	}

	/*
	 * V klidu je obrys neviditelný. Hranice parcel kreslí katastrální podklad
	 * pod ním — obrys by je jen zdvojil druhou barvou. Zůstává tu kvůli
	 * ovládání: nese kliknutí, Tab i bublinu s výměrou, a ukáže se teprve
	 * při najetí nebo výběru, kde je odpovědí na to, co dělá uživatel.
	 *
	 * pointer-events: all znamená, že se parcela chytá celou plochou, ne jen
	 * namalovanou čarou. Díry ve výplni (vyňaté stavební parcely) zůstávají
	 * dírami i pro myš, takže se kliknutí nepřebíjejí.
	 */
	.obrys {
		fill: none;
		stroke: transparent;
		stroke-width: calc(2.6px / var(--u));
		stroke-linejoin: round;
		pointer-events: all;
		cursor: pointer;
		outline: none;
	}

	.obrys:hover,
	.obrys:focus-visible {
		stroke: #9fd4ff;
		stroke-width: calc(4px / var(--u));
	}

	.obrys.je-zvyraznena {
		stroke: #cfe9ff;
		stroke-width: calc(5px / var(--u));
	}

	.vyplen.je-pozemek {
		fill: var(--barva-nabidka);
		fill-opacity: 0.2;
	}

	/*
	 * Jediná čára, kterou mapa kreslí sama od sebe. Hranice pozemku u domu se
	 * teprve oddělí geometrickým plánem, takže v katastrálním podkladu není
	 * — a je proto to jediné, co obtažením něco přidává, ne zdvojuje.
	 * Že jedna její strana nemá oporu v katastru, říká text pod mapou.
	 */
	.pozemek {
		fill: none;
		pointer-events: none;
		stroke: #35a4ff;
		stroke-width: calc(2.6px / var(--u));
		stroke-linejoin: round;
	}

	/*
	 * Vybraná parcela nemění jen průhlednost, ale i odstín. Samotná průhlednost
	 * by u stavebních parcel skoro nebyla vidět — začínají na 0.42, takže mezi
	 * klidem a výběrem by zbyl jen nepatrný rozdíl.
	 *
	 * Krytí zůstává pod polovinou schválně: výš už modrá překryje porost
	 * a z parcely se stane jednolitá plocha. Výběr nese odstín a silnější
	 * obrys, ne neprůhlednost — kupující má pořád vidět, co kupuje.
	 */
	.vyplen.je-zvyraznena {
		fill: var(--barva-nabidka-vybrana);
		fill-opacity: 0.45;
	}

	/*
	 * Parcely mimo nabídku se nekreslí vůbec — hranici i číslo jim dává
	 * katastrální podklad a druhá vrstva by je jen zdvojila. Třídy zůstávají,
	 * protože podle je-mimo pozná skript, že se nemají zvýrazňovat.
	 */
	.vyplen.je-mimo {
		fill: none;
	}

	.obrys.je-mimo {
		stroke: none;
		pointer-events: none;
		cursor: default;
	}

	.mapa__popisky text {
		font: 600 calc(13.5px / var(--u)) ui-monospace, Consolas, monospace;
		fill: #fff;
		text-anchor: middle;
		dominant-baseline: middle;
		paint-order: stroke;
		pointer-events: none;
	}

	.mapa__popisky .halo {
		stroke: #0b0d0b;
		stroke-width: calc(3.4px / var(--u));
		opacity: 0.92;
	}

	.popisek.je-skryty {
		display: none;
	}

	.mapa__sever {
		position: absolute;
		top: 10px;
		right: 12px;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: rgba(10, 12, 10, 0.62);
		color: #fff;
		font: 600 11px/26px var(--pismo-ui);
		text-align: center;
	}

	.mapa__sever::before {
		content: '▲';
		position: absolute;
		top: -9px;
		left: 50%;
		transform: translateX(-50%);
		font-size: 9px;
	}

	.mapa__meritko {
		position: absolute;
		left: 12px;
		bottom: 11px;
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: 0.4rem;
		max-width: calc(100% - 24px);
		background: rgba(10, 12, 10, 0.62);
		padding: 5px 8px;
		border-radius: 2px;
	}

	.mapa__meritko i {
		display: block;
		flex: none;
		height: 5px;
		border: 1.5px solid #fff;
		border-top: none;
	}

	.mapa__meritko span {
		color: #fff;
		white-space: nowrap;
		font: 600 11px/1 ui-monospace, Consolas, monospace;
	}

	.mapa__zoom {
		position: absolute;
		right: 10px;
		bottom: 10px;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.mapa__zoom button {
		width: 34px;
		height: 34px;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 3px;
		background: rgba(10, 12, 10, 0.66);
		color: #fff;
		font: 500 17px/1 var(--pismo-ui);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.mapa__zoom button:hover {
		background: rgba(10, 12, 10, 0.85);
	}

	.mapa__zoom button:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 1px;
	}

	.mapa__zoom button[disabled] {
		opacity: 0.4;
		cursor: default;
	}
</style>

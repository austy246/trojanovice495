---
/*
 * Mřížka naskenovaných výkresů. Kliknutí otevře list přes celou obrazovku,
 * kde se dá kolečkem, dvojklikem nebo dvěma prsty přiblížit — kóty a popisky
 * jsou v původním skenu drobné a jinak by se nedaly přečíst.
 */
import { nakresy } from '../data/nakresy';
---

<section class="sekce" id="nakresy">
	<div class="obsah">
		<p class="nadpis-sekce">Dokumentace</p>
		<h2>Stavební výkresy</h2>
		<p class="uvod">
			Půdorysy, řezy a konstrukční výkresy z projektu domu (Architektonický ateliér A.J.A,
			Ing.&nbsp;arch.&nbsp;Aleš Jílek, 2004). Kliknutím se list otevře přes celou obrazovku
			a dá se v něm přiblížit.
		</p>

		{/* Překreslené schéma stojí nad skeny — dispozice je z něj čitelná na první pohled. */}
		<figure class="schema">
			<a href="/nakresy/schema-prizemi.svg" target="_blank" rel="noopener">
				<img
					src="/nakresy/schema-prizemi.svg"
					alt="Schéma dispozice přízemí: koupelna, technické zázemí, zádveří, pracovna, pokoj a spíž
						při vstupní straně, šatna, druhá koupelna a vstupní hala uprostřed, ložnice, jídelní hala
						s galerií a kuchyň v jižní části, obytná hala s terasou v křídle."
					width="1420"
					height="1442"
					loading="lazy"
					decoding="async"
				/>
			</a>
			<figcaption>
				Dispozice přízemí, překresleno podle projektu. Plochy jsou z legendy místností;
				schéma je orientační a nenahrazuje výkres.
			</figcaption>
		</figure>

		<ul class="vykresy">
			{
				nakresy.map((n, i) => (
					<li>
						<button type="button" class="dlazdice" data-nakres={i}>
							<img
								src={`/nakresy/nahledy/${n.soubor}`}
								alt={n.nazev}
								loading="lazy"
								decoding="async"
								style={`aspect-ratio: ${n.pomer}`}
							/>
							<span class="dlazdice__nazev">{n.nazev}</span>
							<span class="dlazdice__popis">{n.popis}</span>
						</button>
					</li>
				))
			}
		</ul>
	</div>
</section>

<dialog class="lupa" id="lupa" aria-label="Prohlížeč výkresů">
	<div class="lupa__platno" id="lupa-platno">
		<img id="lupa-obrazek" alt="" draggable="false" />
	</div>

	<div class="lupa__lista">
		<p class="lupa__popisek"><strong id="lupa-nazev"></strong> <span id="lupa-popis"></span></p>
		<div class="lupa__ovladani">
			<a id="lupa-plna" href="#" target="_blank" rel="noopener">Plná velikost&nbsp;↗</a>
			<button type="button" id="lupa-predchozi" aria-label="Předchozí výkres">←</button>
			<button type="button" id="lupa-dalsi" aria-label="Další výkres">→</button>
			<button type="button" id="lupa-zavrit" aria-label="Zavřít">✕</button>
		</div>
	</div>
</dialog>

<script>
	import { nakresy } from '../data/nakresy';

	const dialog = document.getElementById('lupa') as HTMLDialogElement | null;
	const platno = document.getElementById('lupa-platno');
	const obrazek = document.getElementById('lupa-obrazek') as HTMLImageElement | null;
	const nazev = document.getElementById('lupa-nazev');
	const popis = document.getElementById('lupa-popis');
	const plna = document.getElementById('lupa-plna') as HTMLAnchorElement | null;

	if (dialog && platno && obrazek && nazev && popis && plna) {
		const MAX = 8;
		let index = 0;
		let k = 1;
		let x = 0;
		let y = 0;

		const uplatni = () => {
			obrazek.style.transform = `translate(${x}px, ${y}px) scale(${k})`;
			platno.dataset.priblizeno = k > 1.01 ? '1' : '0';
		};

		const ukaz = (i: number) => {
			const n = nakresy[i];
			if (!n) return;
			index = i;
			obrazek.src = `/nakresy/${n.soubor}`;
			obrazek.alt = n.nazev;
			nazev.textContent = n.nazev;
			popis.textContent = n.popis;
			plna.href = `/nakresy/${n.soubor}`;
			k = 1;
			x = 0;
			y = 0;
			uplatni();
		};

		const posun = (o: number) => ukaz((index + o + nakresy.length) % nakresy.length);

		document.querySelectorAll<HTMLElement>('[data-nakres]').forEach((el) => {
			el.addEventListener('click', () => {
				ukaz(Number(el.dataset.nakres));
				dialog.showModal();
			});
		});

		document.getElementById('lupa-zavrit')?.addEventListener('click', () => dialog.close());
		document.getElementById('lupa-predchozi')?.addEventListener('click', () => posun(-1));
		document.getElementById('lupa-dalsi')?.addEventListener('click', () => posun(1));

		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') posun(-1);
			if (e.key === 'ArrowRight') posun(1);
		});

		// kliknutí mimo výkres zavírá, ale ne když se právě táhlo
		let tazeno = false;
		dialog.addEventListener('click', (e) => {
			if (!tazeno && e.target === dialog) dialog.close();
		});

		const naPlatne = (e: { clientX: number; clientY: number }): [number, number] => {
			const b = platno.getBoundingClientRect();
			return [e.clientX - b.left - b.width / 2, e.clientY - b.top - b.height / 2];
		};

		const zoomNa = (cx: number, cy: number, nasobek: number) => {
			const nove = Math.min(MAX, Math.max(1, k * nasobek));
			const pomer = nove / k;
			x = cx - (cx - x) * pomer;
			y = cy - (cy - y) * pomer;
			k = nove;
			if (k <= 1.01) {
				x = 0;
				y = 0;
			}
			uplatni();
		};

		platno.addEventListener(
			'wheel',
			(e) => {
				e.preventDefault();
				const [cx, cy] = naPlatne(e);
				zoomNa(cx, cy, Math.exp(-e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0016)));
			},
			{ passive: false },
		);

		platno.addEventListener('dblclick', (e) => {
			const [cx, cy] = naPlatne(e);
			zoomNa(cx, cy, k > 1.01 ? 1 / k : 3);
		});

		// tažení myší i prstem, dva prsty přibližují
		const body = new Map<number, [number, number]>();
		let start: { cx: number; cy: number; x: number; y: number; k: number; dist: number } | null = null;

		platno.addEventListener('pointerdown', (e) => {
			if (e.button > 0) return;
			body.set(e.pointerId, naPlatne(e));
			tazeno = false;
			start = null;
			platno.setPointerCapture(e.pointerId);
		});

		const stred = (): { cx: number; cy: number; dist: number } => {
			const b = [...body.values()];
			const cx = b.reduce((s, p) => s + p[0], 0) / b.length;
			const cy = b.reduce((s, p) => s + p[1], 0) / b.length;
			const dist =
				b.length > 1 ? Math.hypot(b[0]![0] - b[1]![0], b[0]![1] - b[1]![1]) : 0;
			return { cx, cy, dist };
		};

		window.addEventListener('pointermove', (e) => {
			if (!body.has(e.pointerId)) return;
			body.set(e.pointerId, naPlatne(e));
			const s = stred();
			if (!start) {
				start = { ...s, x, y, k };
				return;
			}
			if (Math.hypot(s.cx - start.cx, s.cy - start.cy) > 3) tazeno = true;

			const nasobek = start.dist > 10 && s.dist > 10 ? s.dist / start.dist : 1;
			const nove = Math.min(MAX, Math.max(1, start.k * nasobek));
			k = nove;
			x = s.cx - (start.cx - start.x) * (nove / start.k);
			y = s.cy - (start.cy - start.y) * (nove / start.k);
			if (k <= 1.01) {
				x = 0;
				y = 0;
			}
			uplatni();
		});

		const konec = (e: PointerEvent) => {
			if (!body.delete(e.pointerId)) return;
			start = null;
			if (body.size === 0) setTimeout(() => (tazeno = false), 0);
		};
		window.addEventListener('pointerup', konec);
		window.addEventListener('pointercancel', konec);
	}
</script>

<style>
	.uvod {
		max-width: 42rem;
		margin: 0 0 2rem;
		color: var(--barva-text-tlumena);
	}

	.schema {
		margin: 0 0 2.5rem;
	}

	.schema a {
		display: block;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: #fbf9f6;
		transition: border-color 0.15s;
	}

	.schema a:hover,
	.schema a:focus-visible {
		border-color: var(--barva-akcent);
	}

	.schema img {
		width: 100%;
		height: auto;
	}

	.schema figcaption {
		margin-top: 0.6rem;
		font-size: 0.875rem;
		color: var(--barva-text-tlumena);
	}

	.vykresy {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		gap: 1.5rem;
	}

	.dlazdice {
		display: block;
		width: 100%;
		text-align: left;
		font: inherit;
		color: inherit;
		background: none;
		border: 0;
		padding: 0;
		cursor: zoom-in;
	}

	.dlazdice img {
		width: 100%;
		object-fit: contain;
		background: #fff;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		transition: border-color 0.15s;
	}

	.dlazdice:hover img,
	.dlazdice:focus-visible img {
		border-color: var(--barva-akcent);
	}

	.dlazdice__nazev {
		display: block;
		margin-top: 0.6rem;
		font-family: var(--pismo);
		font-size: 1.0625rem;
	}

	.dlazdice__popis {
		display: block;
		font-size: 0.875rem;
		color: var(--barva-text-tlumena);
	}

	.lupa {
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		background: #14120f;
		color: #fff;
		overflow: hidden;
	}

	.lupa::backdrop {
		background: rgba(16, 14, 11, 0.9);
	}

	.lupa__platno {
		position: absolute;
		inset: 0 0 4.5rem;
		display: grid;
		place-items: center;
		overflow: hidden;
		touch-action: none;
		cursor: zoom-in;
	}

	.lupa__platno[data-priblizeno='1'] {
		cursor: grab;
	}

	.lupa__platno img {
		max-width: 100%;
		max-height: 100%;
		/* pixely zůstávají ostré i po přiblížení, ať jsou kóty čitelné */
		transform-origin: center;
		user-select: none;
		-webkit-user-drag: none;
	}

	.lupa__lista {
		position: absolute;
		inset: auto 0 0;
		height: 4.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		background: #14120f;
	}

	.lupa__popisek {
		margin: 0;
		font-size: 0.9375rem;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.lupa__popisek strong {
		font-family: var(--pismo);
		font-weight: 400;
	}

	.lupa__popisek span {
		color: rgba(255, 255, 255, 0.6);
	}

	.lupa__ovladani {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex: none;
	}

	.lupa__ovladani a {
		color: rgba(255, 255, 255, 0.75);
		font-size: 0.875rem;
		text-decoration: none;
		margin-right: 0.5rem;
		white-space: nowrap;
	}

	.lupa__ovladani button {
		width: 2.5rem;
		height: 2.5rem;
		font: inherit;
		font-size: 1rem;
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 2px;
		cursor: pointer;
	}

	.lupa__ovladani a:hover,
	.lupa__ovladani button:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.2);
	}

	@media (max-width: 34rem) {
		.lupa__popisek span {
			display: none;
		}

		.lupa__ovladani a {
			display: none;
		}
	}
</style>

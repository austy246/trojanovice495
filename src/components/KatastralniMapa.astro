---
import { parcely, pozemekUDomu, VYREZY } from '../data/parcely';

interface Props {
	/** který výřez se vykresluje */
	varianta: 'prehled' | 'detail';
	/** popisek pod mapou, slouží zároveň jako přístupový název */
	popis: string;
}

const { varianta, popis } = Astro.props;

const jeNase = (p: (typeof parcely)[number]) => Boolean(p.cast);

/*
 * Kreslí se vždy všechny parcely — soused je užitečný kontext. Ty mimo
 * nabídku ale dostanou třídu je-mimo: ztlumené, bez kliknutí i bez Tabu.
 */
const trida = (p: (typeof parcely)[number]) => {
	const zaklad = p.stavebni ? 'je-st' : 'je-poz';
	return jeNase(p) ? zaklad : `${zaklad} je-mimo`;
};

/*
 * Hranice kreslí podklad z katastru. SVG je nad ním jen zvýraznění nabídky,
 * takže obrys dostanou pouze naše parcely — jinak by každá čára v mapě ležela
 * dvakrát, jednou žlutě z podkladu a jednou modře z RÚIAN.
 */
const sObrysem = parcely.filter(jeNase);

const vyrez = VYREZY[varianta];
const viewBox = `0 0 ${vyrez.sirka} ${vyrez.vyska}`;
const pomer = ((vyrez.vyska / vyrez.sirka) * 100).toFixed(3);

/*
 * Popisky nese SVG, ne podklad. V přehledu se čísluje i okolí, v detailu jen
 * nabídka — ten je o ní a čísla sousedů by se do něj tlačila od kraje. Parcela
 * navíc může z výřezu vybíhat; její popisek míří na střed celé parcely, takže
 * by u hrany zůstal viset jako útržek.
 */
const sPopiskem = parcely.filter((p) => {
	const z = p[varianta];
	if (z.x < 0 || z.y < 0 || z.x > vyrez.sirka || z.y > vyrez.vyska) return false;
	return varianta === 'prehled' || jeNase(p);
});

/*
 * Rozteč šrafů se odvozuje od šířky výřezu, aby byly v obou mapách stejně
 * husté na obrazovce, ne v jednotkách viewBoxu.
 */
const krok = Math.round(vyrez.sirka / 55);
const idSraf = `srafy-${varianta}`;

const pozemek = pozemekUDomu[varianta];
---

<figure class="mapa-fig">
	<div class="mapa" data-mapa={varianta} data-sirka={vyrez.sirka}>
		<div class="mapa__pomer" style={`padding-top:${pomer}%`}></div>

		{/*
		 * Obě mapy se skládají stejně: ortofoto ČÚZK a nad ním katastrální kresba
		 * jako samostatná průhledná vrstva. Oboje generuje scripts/podklady.mjs.
		 */}
		<div class="mapa__scena">
			<picture>
				<source srcset={`/katastr/${varianta}-orto.avif`} type="image/avif" />
				<img
					class="mapa__vrstva mapa__orto"
					src={`/katastr/${varianta}-orto.webp`}
					alt="Ortofoto ČÚZK"
					draggable="false"
					loading="lazy"
				/>
			</picture>

			<svg class="mapa__vrstva mapa__vyplne" viewBox={viewBox} preserveAspectRatio="none" aria-hidden="true">
				<defs>
					<pattern id={idSraf} width={krok} height={krok} patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
						<line x1="0" y1="0" x2="0" y2={krok} stroke="#8ecbff" stroke-width={krok / 5} />
					</pattern>
				</defs>

				{
					parcely.map((p) => (
						<path class={`vyplen ${trida(p)}`} data-p={p.cislo} d={p[varianta].d} />
					))
				}

				{/*
				 * Šrafy nesou modrou plochu nabídky: vymezený pozemek u domu
				 * a všechny parcely háječku. Obě stavební parcely u domu leží
				 * uvnitř pozemku, šrafy přes ně už proto jdou.
				 */}
				<path class="vyplen je-pozemek" d={pozemek.d} />
				<path class="srafy" d={pozemek.d} fill={`url(#${idSraf})`} />
				{
					parcely
						.filter((p) => p.cast === 'hajecek')
						.map((p) => <path class="srafy" d={p[varianta].d} fill={`url(#${idSraf})`} />)
				}
			</svg>

			<img
				class="mapa__vrstva mapa__km"
				src={`/katastr/${varianta}-kresba.webp`}
				alt="Katastrální mapa ČÚZK"
				draggable="false"
				loading="lazy"
			/>

			<svg class="mapa__vrstva" viewBox={viewBox} preserveAspectRatio="none" role="img" aria-label={popis}>
				{
					sObrysem.map((p) => (
						<path
							class={`obrys ${trida(p)}`}
							data-p={p.cislo}
							d={p[varianta].d}
							tabindex="0"
							role="button"
							aria-label={`${p.cislo}, ${p.vymera} m², ${p.druh}`}
						>
							<title>{`${p.cislo} · ${p.vymera} m² · ${p.druh}`}</title>
						</path>
					))
				}
				<path class="pozemek" d={pozemek.d} />

				{/*
				 * Podklad se stahuje bez čísel (vrstva hranic místo skupinové KN_I),
				 * protože rastrový popisek má velikost v terénu — v přehledu by
				 * vyšel na pár pixelů. Tenhle drží velikost na obrazovce a schová
				 * se, až když se do parcely přestane vejít.
				 */}
				<g class="mapa__popisky">
					{
						sPopiskem.map((p) => (
							<g class={`popisek ${jeNase(p) ? '' : 'je-mimo'}`} data-p={p.cislo} data-fit={p[varianta].fit}>
								<text x={p[varianta].x} y={p[varianta].y} class="halo">
									{p.cislo}
								</text>
								<text x={p[varianta].x} y={p[varianta].y}>
									{p.cislo}
								</text>
							</g>
						))
					}
				</g>
			</svg>
		</div>

		<div class="mapa__sever" aria-hidden="true">S</div>
		<div class="mapa__meritko" data-podil={vyrez.meritkoPodil}>
			<i></i>
			<span data-meritko={vyrez.meritko}>{vyrez.meritko} m</span>
		</div>
		<div class="mapa__zoom">
			<button type="button" data-z="in" aria-label="Přiblížit">+</button>
			<button type="button" data-z="out" aria-label="Oddálit">−</button>
			<button type="button" data-z="reset" aria-label="Zpět na celý výřez">⟲</button>
		</div>
	</div>
	<figcaption>{popis}</figcaption>
</figure>

<style>
	.mapa-fig {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.mapa-fig figcaption {
		color: var(--barva-text-tlumena);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	/*
	 * --u = kolik pixelů displeje připadá na jednotku viewBoxu. Obrysy i popisky
	 * se jím dělí, takže při zvětšení drží stálou tloušťku a velikost.
	 */
	.mapa {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--barva-linka);
		border-radius: 2px;
		background: #0c0e0c;
		line-height: 0;
		touch-action: pan-y;
		cursor: grab;
		--u: 0.25;
	}

	.mapa.je-zvetsena {
		touch-action: none;
	}

	.mapa.je-tazena {
		cursor: grabbing;
	}

	.mapa__pomer {
		width: 100%;
	}

	.mapa__scena {
		position: absolute;
		inset: 0;
		transform-origin: 0 0;
		will-change: transform;
	}

	.mapa__vrstva {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		user-select: none;
	}

	/*
	 * Barvu výplně a barvu obrysu drž v oddělených pravidlech. Sloučené
	 * `.vyplen.je-st, .obrys.je-st { fill: … }` má vyšší specificitu než
	 * `.obrys { fill: none }` a obarvilo by i obrysovou vrstvu, která žádnou
	 * průhlednost nemá — parcely by přes ortofoto vyšly jako plné plochy.
	 */
	/*
	 * Nabízené pozemky jsou modré; stavební parcely jen sytěji, protože jsou
	 * drobné a proti ortofotu by se ztratily.
	 */
	.vyplen {
		stroke: none;
		fill: #2e9bff;
		fill-opacity: 0.14;
	}

	.vyplen.je-st {
		fill: #0f7ae5;
		fill-opacity: 0.42;
	}

	/* Šrafy leží nad výplní a nesmí brát kliknutí obrysové vrstvě pod sebou. */
	.srafy {
		pointer-events: none;
		opacity: 0.32;
	}

	/*
	 * Šířka čáry má dvě spodní meze. calc(…/ --u) drží stálou tloušťku na
	 * obrazovce, ta ale při přiblížení klesá v jednotkách mapy — a žlutá čára
	 * podkladu roste s přiblížením, protože je součástí rastru. Druhý člen je
	 * proto pevný v jednotkách viewBoxu. Kresba KN je čtvrt metru široká, ale
	 * roztažený rastr ji rozmaže do zhruba půl metru; 7 dm ji i s tolerancí
	 * zákresu přikryje v každém přiblížení, takže hranice zůstane jedna čára,
	 * ne dvě vedle sebe.
	 */
	.obrys {
		fill: none;
		stroke-width: max(calc(2.6px / var(--u)), 7px);
		stroke-linejoin: round;
		cursor: pointer;
		outline: none;
	}

	.obrys.je-st {
		stroke: #c7e9ff;
	}

	.obrys.je-poz {
		stroke: #35a4ff;
	}

	/*
	 * Vymezený pozemek u domu nese modrou plochu nabídky, proto vypadá jako
	 * nabízená parcela — včetně obvodu. Že jedna jeho strana nemá oporu
	 * v katastru, říká text pod mapou, ne odlišná čára.
	 */
	.vyplen.je-pozemek {
		fill: #2e9bff;
		fill-opacity: 0.2;
	}

	.pozemek {
		fill: none;
		pointer-events: none;
		stroke: #35a4ff;
		stroke-width: max(calc(2.6px / var(--u)), 7px);
		stroke-linejoin: round;
	}

	.obrys:hover,
	.obrys.je-zvyraznena,
	.obrys:focus-visible {
		stroke-width: max(calc(5px / var(--u)), 10px);
	}

	.vyplen.je-zvyraznena {
		fill-opacity: 0.6;
	}

	/*
	 * Parcely mimo nabídku. Hranici jim kreslí podklad, SVG přidává jen slabé
	 * zašednutí a v přehledu číslo — nedají se kliknout ani chytit Tabem
	 * a nereagují na zvýraznění.
	 */
	.vyplen.je-mimo {
		fill: #fff;
		fill-opacity: 0.06;
	}

	.popisek.je-mimo text {
		fill: rgba(255, 255, 255, 0.5);
	}

	.mapa__popisky text {
		font: 600 calc(13.5px / var(--u)) ui-monospace, Consolas, monospace;
		fill: #fff;
		text-anchor: middle;
		dominant-baseline: middle;
		paint-order: stroke;
		pointer-events: none;
	}

	.mapa__popisky .halo {
		stroke: #0b0d0b;
		stroke-width: calc(3.4px / var(--u));
		opacity: 0.92;
	}

	.popisek.je-skryty {
		display: none;
	}

	.mapa__sever {
		position: absolute;
		top: 10px;
		right: 12px;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: rgba(10, 12, 10, 0.62);
		color: #fff;
		font: 600 11px/26px var(--pismo-ui);
		text-align: center;
	}

	.mapa__sever::before {
		content: '▲';
		position: absolute;
		top: -9px;
		left: 50%;
		transform: translateX(-50%);
		font-size: 9px;
	}

	.mapa__meritko {
		position: absolute;
		left: 12px;
		bottom: 11px;
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: 0.4rem;
		max-width: calc(100% - 24px);
		background: rgba(10, 12, 10, 0.62);
		padding: 5px 8px;
		border-radius: 2px;
	}

	.mapa__meritko i {
		display: block;
		flex: none;
		height: 5px;
		border: 1.5px solid #fff;
		border-top: none;
	}

	.mapa__meritko span {
		color: #fff;
		white-space: nowrap;
		font: 600 11px/1 ui-monospace, Consolas, monospace;
	}

	.mapa__zoom {
		position: absolute;
		right: 10px;
		bottom: 10px;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.mapa__zoom button {
		width: 34px;
		height: 34px;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 3px;
		background: rgba(10, 12, 10, 0.66);
		color: #fff;
		font: 500 17px/1 var(--pismo-ui);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.mapa__zoom button:hover {
		background: rgba(10, 12, 10, 0.85);
	}

	.mapa__zoom button:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 1px;
	}

	.mapa__zoom button[disabled] {
		opacity: 0.4;
		cursor: default;
	}
</style>
